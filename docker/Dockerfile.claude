FROM node:20-bullseye

# Системные пакеты
RUN apt-get update && apt-get install -y \
    git \
    curl \
    nano \
    vim \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Создаём non-root пользователя (UID 1000 стандартный для dev containers)
RUN useradd -m -s /bin/bash -u 1000 developer && \
    echo "developer ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Установка Claude Code глобально
RUN npm install -g @anthropic-ai/claude-code

# Установка зависимостей Python для проекта
WORKDIR /workspace
COPY requirements.txt* ./
RUN if [ -f requirements.txt ]; then pip install --no-cache-dir -r requirements.txt; else echo "requirements.txt не найден"; fi

# Права на workspace
RUN chown -R developer:developer /workspace

# Переключаемся на non-root пользователя
USER developer

# Удобства в ~/.bashrc пользователя
RUN echo 'alias ll="ls -lah"' >> ~/.bashrc && \
    echo 'export PYTHONUNBUFFERED=1' >> ~/.bashrc && \
    echo 'export PATH="/workspace/.venv/bin:$PATH"' >> ~/.bashrc

CMD ["bash"]
