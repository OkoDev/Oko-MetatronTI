  , max_labels_count = 500
  , max_lines_count = 500
  , max_boxes_count = 500
  , max_bars_back = 5000)


showAlerts = input.bool(true, "Alerts", group = "Show settings",inline = "01")
scalpingAlerts = input.bool(true, "Scalping", group = "Show settings", inline = "01")
showPivots = input.bool(true, "Pivots", group = "Show settings",inline = "01")

showOrderBlocks = input.bool(true, "Order Blocks", group = "Show settings",inline = "02")
showChannel = input.bool(true, "Channel", group = "Show settings",inline = "02")
show3orMore = input.bool(true, "3 or More", group = "Show settings",inline = "02")

// showBBinput = input.bool(true, "BB", group = "Show settings",inline = "02")

i_zigZag     = input.bool(true, "Waves", group = "Show settings", inline = "03")
showCmaLines = input.bool(true, "CMA", group = "Show settings",inline = "03")
showBarColor = input.bool(true, "Bar Colors", group = "Show settings",inline = "03")
showTrendLine = input.bool(true, "Trend line", group = "Show settings",inline = "03")

