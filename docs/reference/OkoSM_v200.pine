array.set(i_settingsB, 1, INP_supportsB)
array.set(i_settingsB, 2, INP_resistsB)
// -- drawing settings for selection C
array.set(i_settingsC, 0, INP_showPivotsC ? 1 : 0)
array.set(i_settingsC, 1, INP_supportsC)
array.set(i_settingsC, 2, INP_resistsC)

// -------------------------------------------------- Pivots styling options --------------------------------------------------


////////////////////////////////////////////////////////////////////////////////
//                                                                            //
//                          ====== FUNCTIONS ======                           //
//                                                                            //
////////////////////////////////////////////////////////////////////////////////

f_getResolution( _inputResolution ) =>
    //  string  _inputResolution : user selected resolution input
    // () Description:
    //  - Resolver for custom resolution input selection, converts input to
    //    compatible return string for security, output is also used for less
    //    verbose label text options.
    // Dependencies:
    //  - i_res1, i_res2, i_res3, i_res4, i_res5, i_res6
    //  - i_res7, i_res8, i_res9, i_res10, i_res11, i_res12
    // Notes:
    //  - i_res0 excluded as it's a token placeholder for default "60".

    string _r       = _inputResolution  // a more ternary challenge friendly var
    string _default = "60"              // if i_res0 was input, or failure.

    // compare input to determine proper string return for security calls.
    _return = _r == i_res1 ? "120"  : _r == i_res2 ? "180"  : _r == i_res3 ? "240"  :
              _r == i_res4 ? "360"  : _r == i_res5 ? "720"  : _r == i_res6 ? "1D"   :
              _r == i_res7 ? "5D"   : _r == i_res8 ? "1W"   : _r == i_res9 ? "1M"   :
              _r == i_res10 ? "3M"  : _r == i_res11 ? "6M"  : _r == i_res12 ? "12M" : _default

f_getLineStyle( _inputStyle ) =>
    //  string  _inputStyle : user selected style input
    // () resolver for custom line style input selection, returns a usable
    //    line style type.
    // Dependencies:
    //  - i_line1, i_line2
    // Notes:
    //  * i_line0 omitted as we default to 'line.style_solid' anyway

    // compare input to determine proper line style to return.
    _return = _inputStyle == i_line1 ? line.style_dotted :
              _inputStyle == i_line2 ? line.style_dashed : line.style_solid

// -- helper function for checking if a value is inside a min-max range
f_isInsideRange(_val, _min, _max) => _val >= _min and _val <= _max

f_getPivotTraditional( _prevHigh, _prevLow, _prevClose ) =>
    //  float   _prevHigh | _prevLow | _prevClose : HTF security OHLC values
    // () calculates a pivot set and assigns to proper array indexes for return.
    // Notes:
    //  - f_renderPivotArray() expects float data in the following sequence..
    //
    //      Pivot     : [ 0 ]
    //      Supports  : [ 1 to i_maxLevels ]
    //      Resists   : [ ( i_maxLevels + 1 ) to i_maxLength ]

    // init empty array with predefined length of i_maxLength
    var float[] _array = array.new_float( i_maxLength, na )

    // pivot level, array index [0]
    _pivot = ( _prevHigh + _prevLow + _prevClose ) / 3
    array.set( _array, 0, _pivot )

    // support levels, array indexes [1] through [i_maxLevels]
    array.set( _array, 1, _pivot * 2.003 - _prevHigh )
    array.set( _array, 2, _pivot - ( _prevHigh - _prevLow ) )
    array.set( _array, 3, _pivot * 2 - ( 2 * _prevHigh - _prevLow ) )
    array.set( _array, 4, _pivot * 3 - ( 3 * _prevHigh - _prevLow ) )
    array.set( _array, 5, _pivot * 4 - ( 4 * _prevHigh - _prevLow ) )

    // resistance levels, array indexes [i_maxLevels + 1] through [i_maxLength]
    array.set( _array, 1 + i_maxLevels, _pivot * 1.997 - _prevLow )
    array.set( _array, 2 + i_maxLevels, _pivot + ( _prevHigh - _prevLow ) )
    array.set( _array, 3 + i_maxLevels, _pivot * 2 + ( _prevHigh - 2 * _prevLow ) )
    array.set( _array, 4 + i_maxLevels, _pivot * 3 + ( _prevHigh - 3 * _prevLow ) )
    array.set( _array, 5 + i_maxLevels, _pivot * 4 + ( _prevHigh - 4 * _prevLow ) )

    _return = _array


f_getPivotSet( _flavour, _resolution ) =>
    //  string  _flavour    : user input pivot type selection
    //  string  _resolution : user input resolution selection
    // () gets OHLC values from selected resolution, and returns requested
    //    pivot calculation array.

    // previous OHLC series for selected resolution
    [ _prevOpen,
      _prevHigh,
      _prevLow,
      _prevClose ] =  request.security( syminfo.tickerid, _resolution, [ open[1], high[1], low[1], close[1] ], lookahead = barmerge.lookahead_on )
    
    var float _currOpen = na
    if ta.change( time( _resolution ) ) != 0
        _currOpen := open

    // float array to contain S|R levels for return.
    var float[] _pivotSet = array.new_float(i_maxLength, na)

    _pivotSet := _flavour == i_piv0? f_getPivotTraditional( _prevHigh, _prevLow, _prevClose ) : na

    _pivotSet // return the float array

f_renderPivotArray( _resolution, _settings, _floats, _lines, _labels ) =>
    //  string  _resolution : user selected resolution input
    //  int[]   _settings   : pivot specific input settings
    //  float[] _floats     : pivot float array
    //  line[]  _lines      : line array to hold rendered lines
    //  label[] _labels     : label array to hold rendered labels
    //  
    // () Description:
    //  - Designed for scalability and plug-n-play functionality if any new
    //    pivot type is added, or extended.
    //  - If a f_pivotType() function properly assigns it's float values in the
    //    following format/order, it should be able to to render them with no
    //    hassle at all.
    //
    //      Pivot     : [ 0 ]
    //      Supports  : [ 1 to i_maxLevels ]
    //      Resists   : [ ( i_maxLevels + 1 ) to i_maxLength ]  

    // set up a few common vars for drawing using 'time' placement
    _xloc   = xloc.bar_time
    _x1     = ta.valuewhen( ta.change( time( _resolution ) ), time, 0 ) // time
    _x2     = time_close( _resolution ) // new! Thanks pine team <3

    // set up some temp vars for creating our lines and labels
    var line    _line       = na
    var label   _labelLeft  = na
    var label   _labelRight = na
    var label   _labelPrice = na

    // init some readable settings variables to hold _settings data
    var bool    _showPivot      = false
    var int     _maxSupports    = i_maxLevels
    var int     _maxResists     = i_maxLevels

    // hand off the settings array to the vars
    _showPivot      := array.get( _settings, 0 ) > 0 ? true : false
    _maxSupports    := array.get( _settings, 1 )
    _maxResists     := array.get( _settings, 2 )

    // if we want to show the particular pivot set
    // * the change() check was causing issues on extended hours intraday charts
    //   so i have removed it for now. I will look into other options for the
    //   next proper update.
    if _showPivot and showPivots // change ( time( _resolution ) ) != 0 and _showPivot
    
        // clean up old lines and labels before drawing our new set
        for i = 1 to array.size( _lines ) // loop and delete 1 by 1
            line.delete( array.get( _lines, i - 1 ) )

        // the label array is dynamic length, so we..
        if array.size( _labels ) > 0 // ..check to see if it has content..
            for i = 1 to array.size( _labels ) // ..then loop it into the trash
                label.delete( array.shift( _labels ) )

        // check for properly populated float array
        if array.size( _floats ) > 0 and not na( array.get( _floats, 0 ) )

            // now loop through the floats
            for i = 1 to array.size( _floats )

                // don't want to bother with [i - 1] throughout the entire loop
                _index = i - 1 // so set up a var

                // if we have a valid float at the current loop index
                if not na( array.get( _floats, _index ) )

                    // common variables used in all conditions
                    _activePrice = array.get( _floats, _index )
                    _priceString = str.tostring( _activePrice, "#.######" )

                    //  IDENTIFYING SUPPORT LEVELS IN ARRAY
                    //
                    // support index range : [ from 1 to i_maxLevels ]
                    if f_isInsideRange( _index, 1, i_maxLevels )

                        // only draw levels : [ from 1 to _maxSupports ]
                        if f_isInsideRange( _index, 1, _maxSupports )

                            // dynamic line width based on index value
                            int     _width  = _index > 3 ? _index - 2 : _index
                            // use index to set level numbers on labels
                            string  _level  = str.tostring( _index )

                            _line   := line.new( _x1, _activePrice, _x2, _activePrice, _xloc, extend.none,
                                                      style = f_getLineStyle( INP_supportStyle ),
                                                      color = INP_supportColour,
                                                      width = _width )

                            // _labelLeft  := label.new( _x1, _activePrice, "S" + _level + "\n", _xloc,
                            //                           style = label.style_label_left,
                            //                           color = #00000000,
                            //                           textcolor = INP_supportColour )

                            _labelRight := label.new( _x2, _activePrice, "S" + _level + "\t" + _priceString, _xloc,
                                                      style = label.style_label_left,
                                                      color = #00000000,
                                                      textcolor = INP_supportColour )

                            // _labelPrice := INP_showPrice ? label.new( _x2, _activePrice, _priceString, _xloc,
                            //                           style = label.style_label_left,
                            //                           color = #00000000,
                            //                           textcolor = INP_priceColour ) : na

                    //  IDENTIFYING RESISTANCE LEVELS IN ARRAY
                    //
                    // resistance index range : [ from (1 + i_maxLevels) to (2 * i_maxLevels) ]
                    else if f_isInsideRange( _index, 1 + i_maxLevels, 2 * i_maxLevels )

                        // only draw levels : [ from (1 + i_maxLevels) to (_maxResists + i_maxLevels) ]
                        if f_isInsideRange( _index, 1 + i_maxLevels, _maxResists + i_maxLevels )

                            // adjusted _index value to attain 1/2/3 sequence for string operation
                            int     _adjust = _index - i_maxLevels
                            // dynamic line width based on adjusted _index value
                            int     _width  = _adjust > 3 ? _adjust - 2 : _adjust
                            // use adjusted index value to set proper level numbers on labels
                            string  _level  = str.tostring( _adjust )

                            _line   := line.new( _x1, _activePrice, _x2, _activePrice, _xloc, extend.none,
                                                      style = f_getLineStyle( INP_resistStyle ),
                                                      color = INP_resistColour,
                                                      width = _width )

                            // _labelRight  := label.new( _x2, _activePrice, "R" + _level + "\t" + _priceString, _xloc,
                            //                           style = label.style_none,
                            //                           color = #00000000,
                            //                           textcolor = INP_resistColour )

                            _labelRight := label.new( _x2, _activePrice, "R" + _level + "\t" + _priceString, _xloc,
                                                      style = label.style_label_left,
                                                      color = #00000000,
                                                      textcolor = INP_resistColour )

                            // _labelPrice := INP_showPrice ? label.new( _x2, _activePrice, _priceString, _xloc,
                            //                           style = label.style_label_left,
                            //                           color = #00000000,
                            //                           textcolor = INP_priceColour ) : na

                    else // PIVOT - No identification needed, always using index 0

                        _line   := line.new( _x1, _activePrice, _x2, _activePrice, _xloc, extend.none,
                                                  style = f_getLineStyle( INP_pivotStyle ),
                                                  color = INP_pivotColour,
                                                  width = 3 )

                        // _labelLeft  := label.new( _x1, _activePrice, "PP\n", _xloc,
                        //                           style = label.style_label_left,
                        //                           color = #00000000,
                        //                           textcolor = INP_pivotColour )

                        _labelRight  := label.new( _x2, _activePrice, "PP\t" + _priceString, _xloc,
                                                  style = label.style_label_left,
                                                  color = #00000000,
                                                  textcolor = INP_pivotColour )
                                                  
                        // _labelRight  := label.new( _x2, _activePrice, "\n" + "\n" + _priceString, _xloc, style =  label.style_none,color = #00000000,textcolor = INP_priceColour )
                                                  
                        // _labelPrice := INP_showPrice ? label.new( _x2, _activePrice, _priceString, _xloc,
                        //                           style = label.style_label_left,
                        //                           color = #00000000,
                        //                           textcolor = INP_priceColour ) : na

                    // set our line to it's respective array index
                    array.set( _lines, _index, _line )

                    // push labels into array, order doesn't matter.
                    if not na(_labelLeft)
                        array.push( _labels, _labelLeft )
                    if not na(_labelRight)
                        array.push( _labels, _labelRight )
                    if not na(_labelPrice)
                        array.push( _labels, _labelPrice )

////////////////////////////////////////////////////////////////////////////////
//                                                                            //
//                   ====== SERIES, LINES and LABELS ======                   //
//                                                                            //
////////////////////////////////////////////////////////////////////////////////

// -- selected resolutions
string _resolutionA = f_getResolution( INP_resolutionA )
string _resolutionB = f_getResolution( INP_resolutionB )
string _resolutionC = f_getResolution( INP_resolutionC )

// -- pivot series price data sets
float[] _pivotFloatsA   = f_getPivotSet( INP_flavourA, _resolutionA )
float[] _pivotFloatsB   = f_getPivotSet( INP_flavourB, _resolutionB )
float[] _pivotFloatsC   = f_getPivotSet( INP_flavourC, _resolutionC )

// -- pivot lines array A, and companion labels array
var line[]  _pivotLinesA    = array.new_line( i_maxLength, na )
var label[] _pivotLabelsA   = array.new_label()

// -- pivot lines array B, and companion labels array
var line[]  _pivotLinesB    = array.new_line( i_maxLength, na )
var label[] _pivotLabelsB   = array.new_label()

// -- pivot lines array C, and companion labels array
var line[]  _pivotLinesC    = array.new_line( i_maxLength, na )
var label[] _pivotLabelsC   = array.new_label()

////////////////////////////////////////////////////////////////////////////////
//                                                                            //
//                     ====== DRAWING and PLOTTING ======                     //
//                                                                            //
////////////////////////////////////////////////////////////////////////////////

// -- feed in our settings and data to the render function for set A
f_renderPivotArray( _resolutionA, i_settingsA, _pivotFloatsA, _pivotLinesA, _pivotLabelsA )

// -- feed in our settings and data to the render function for set B
f_renderPivotArray( _resolutionB, i_settingsB, _pivotFloatsB, _pivotLinesB, _pivotLabelsB )

// -- feed in our settings and data to the render function for set C
f_renderPivotArray( _resolutionC, i_settingsC, _pivotFloatsC, _pivotLinesC, _pivotLabelsC )

// ====== DRAWING and PLOTTING ======   



// ------------- zigzag -------------//
tooltip_zigzag      = 'The Zig Zag indicator is used to identify price trends then connected by straight lines that help the trader visual the price action' + 
                      'This indicator works to eliminate confusion over small price changes or fluctuations and aims to project trend changes overtime'


group_zigzag = 'Waves Settings'

// i_zigZag     = input.bool(true, 'Zig Zag  ', inline='ZZ', group=group_zigzag, tooltip=tooltip_zigzag)
i_zzColor    = input.color(#ffffff, 'Color ', inline='ZZ', group=group_zigzag)
i_zzStyle    = input.string('Dotted', 'Style ', options=['Dashed', 'Dotted', 'Solid'], inline='ZZ', group=group_zigzag)
i_zzWidth    = input.int(1, 'Width', minval=1, inline='ZZ', group=group_zigzag)


// ---------------------------------------------------------------------------------------------- //
// -Calculations -------------------------------------------------------------------------------- //
i_dev_thresh = ta.atr(10) / close * 100 * input.float(3, 'Deviation', minval=0, inline='ZZz', group=group_zigzag)
i_depth      = input.int(11, 'Depth', minval=1, inline='ZZz', group=group_zigzag)


var line lineLast = na
var int iLast = 0
var int iPrev = 0
var float pLast = 0
var isHighLast = false  // otherwise the last pivot is a low pivot

var iPrevPivot = 0
var pPrevPivot = 0.
var iLastPivot = 0
var pLastPivot = 0.

pivots(src, length, isHigh) =>
    l2 = length * 2
    c = nz(src[length])
    ok = true

    for i = 0 to l2 by 1
        if isHigh and src[i] > c
            ok := false
            ok

        if not isHigh and src[i] < c
            ok := false
            ok
    if ok
        [bar_index[length], c]
    else
        [int(na), float(na)]

[iH, pH] = pivots(high, i_depth / 2, true)
[iL, pL] = pivots(low, i_depth / 2, false)

calc_dev(base_price, price) =>
    100 * (price - base_price) / price

pivotFound(dev, isHigh, index, price) =>
    if isHighLast == isHigh and not na(lineLast)
        // same direction
        if isHighLast ? price > pLast : price < pLast
            line.set_xy2(lineLast, index, price)
            [lineLast, isHighLast]
        else
            [line(na), bool(na)]
    else
        // reverse the direction (or create the very first line)
        if math.abs(dev) > i_dev_thresh
            // price move is significant

            // ---------------------------------------------------------------------------------------- //
            [zzCol, zzWid, zzSty] = if not i_zigZag
                [na, 1, line.style_dashed]
            else
                [i_zzColor, i_zzWidth, i_zzStyle == 'Solid' ? line.style_solid : i_zzStyle == 'Dotted' ? line.style_dotted : line.style_dashed]
            // ---------------------------------------------------------------------------------------- //

            id = line.new(iLast, pLast, index, price, color=zzCol, width=zzWid, style=zzSty)
            [id, isHigh]
        else
            [line(na), bool(na)]

if not na(iH)
    dev = calc_dev(pLast, pH)
    [id, isHigh] = pivotFound(dev, true, iH, pH)

    if not na(id)
        if id != lineLast
            // ---------------------------------------------------------------------------------------- //
            iPrevPivot := line.get_x1(lineLast)
            pPrevPivot := line.get_y1(lineLast)
            iLastPivot := line.get_x2(lineLast)
            pLastPivot := line.get_y2(lineLast)

            if not i_zigZag
            // ---------------------------------------------------------------------------------------- //

                line.delete(lineLast)

        lineLast := id
        isHighLast := isHigh
        iPrev := iLast
        iLast := iH
        pLast := pH
        pLast
else
    if not na(iL)
        dev = calc_dev(pLast, pL)
        [id, isHigh] = pivotFound(dev, false, iL, pL)

        if not na(id)
            if id != lineLast
                // ---------------------------------------------------------------------------------------- //
                iPrevPivot := line.get_x1(lineLast)
                pPrevPivot := line.get_y1(lineLast)
                iLastPivot := line.get_x2(lineLast)
                pLastPivot := line.get_y2(lineLast)

                if not i_zigZag
                // ---------------------------------------------------------------------------------------- //

                    line.delete(lineLast)

            lineLast := id
            isHighLast := isHigh
            iPrev := iLast
            iLast := iL
            pLast := pL
            pLast




// ------------------------------------ zigzag ------------------------------------------------------------

//----------------FFPivots--------------//
dp          =   input(true,         title="Show Daily     Future Pivot")
wp          =   input(true,         title="Show Weekly    Future Pivot")
mp          =   input(true,         title="Show Monthly   Future Pivot")

srv         =   input(true,         title="S1 R1 Visible")
LblBR       =   input(#00000000,    title='Label Backround')
txtColor    =   input(color.black,  title='Label Textcolor')

clr         =   input(#D47928,      title='Pivot Color')
clyp        =   input(color.blue,   title='Yearly Pivot Color')
_LineStyle  = input.string('Dotted', 'Style ', options=['Dashed', 'Dotted', 'Solid'])

daily_high  =   request.security(syminfo.tickerid, "D", high,   lookahead=barmerge.lookahead_on)
daily_low   =   request.security(syminfo.tickerid, "D", low,    lookahead=barmerge.lookahead_on)

weekly_high =   request.security(syminfo.tickerid, "W", high,   lookahead=barmerge.lookahead_on)
weekly_low  =   request.security(syminfo.tickerid, "W", low,    lookahead=barmerge.lookahead_on)

monthly_high=   request.security(syminfo.tickerid, "M", high,   lookahead=barmerge.lookahead_on)
monthly_low =   request.security(syminfo.tickerid, "M", low,    lookahead=barmerge.lookahead_on)

var float yearly_high = high
var float yearly_low = low
newmonth = ta.change(time('M')) != 0
if month == 1 and newmonth
    yearly_high := high
    yearly_low := low
else    
    yearly_high := math.max(high, yearly_high)
    yearly_low := math.min(low, yearly_low)

FPP = (daily_high   + daily_low     + close) / 3
FPw = (weekly_high  + weekly_low    + close) / 3
FPm = (monthly_high + monthly_low   + close) / 3
FPy = (yearly_high  + yearly_low    + close) / 3

DR1 = 2 * FPP - daily_low
DS1 = 2 * FPP - daily_high

WR1 = 2 * FPw - weekly_low
WS1 = 2 * FPw - weekly_high

MR1 = 2 * FPm - monthly_low
MS1 = 2 * FPm - monthly_high

YR1 = 2 * FPy - yearly_low
YS1 = 2 * FPy - yearly_high    


//dt = time - time[1]
dyt     =   request.security(syminfo.tickerid, "D", time_close )
dtt      =  request.security(syminfo.tickerid, "D", time_close ) + request.security(syminfo.tickerid, "D", time) - request.security(syminfo.tickerid, "D", time[1])

wyt     =   request.security(syminfo.tickerid, "W", time_close )
wtt      =  request.security(syminfo.tickerid, "W", time_close ) + request.security(syminfo.tickerid, "W", time) - request.security(syminfo.tickerid, "W", time[1])

myt     =   request.security(syminfo.tickerid, "M", time_close )
mtt      =  request.security(syminfo.tickerid, "M", time_close ) + request.security(syminfo.tickerid, "M", time) - request.security(syminfo.tickerid, "M", time[1])


if barstate.islast
    if dp and (timeframe.isintraday)
        ldpp      =   line.new    (x1 = dyt , y1 = FPP  , x2 = dtt , y2 = FPP, xloc = xloc.bar_time, extend=extend.none,   color   =   clr, style = line.style_dotted,    width   =   2)
        line.delete(ldpp[1])
        lbldpp  =   label.new   (x = dtt , y = FPP, text = "PPD" , xloc = xloc.bar_time, color   =   LblBR,    style   =   label.style_label_left)
        label.delete(lbldpp[1])
        if  srv
            lds1p      =   line.new    (x1 = dyt , y1  =   DS1  , x2 = dtt , y2    =   DS1,     xloc = xloc.bar_time, extend=extend.none,   color   =   clr, style = line.style_dotted)
            line.delete(lds1p[1])
            lblds1p  =   label.new   (x = dtt , y = DS1, text = "S1D" , xloc = xloc.bar_time, color   =   LblBR,    style   =   label.style_label_left)
            label.delete(lblds1p[1])
            ldr1p      =   line.new    (x1 = dyt , y1  =   DR1  , x2 = dtt , y2    =   DR1, xloc = xloc.bar_time, extend=extend.none,   color   =   clr, style = line.style_dotted)
            line.delete(ldr1p[1])
            lbldr1p  =   label.new   (x = dtt , y = DR1, text = "R1D" , xloc = xloc.bar_time, color   =   LblBR,    style   =   label.style_label_left)
            label.delete(lbldr1p[1])
            
    if wp   and (timeframe.isintraday or timeframe.isdaily)
        lwpp      =   line.new    (x1 = wyt , y1  =   FPw  , x2 = wtt , y2          =   FPw,    xloc = xloc.bar_time, extend=extend.none,   color   =   clr,    width   =   3)
        line.delete(lwpp[1])
        lblwpp  =   label.new   (x = wtt , y = FPw, text = "PPW" ,                              xloc = xloc.bar_time,                       color   =   LblBR,    style   =   label.style_label_left)
        label.delete(lblwpp[1])
        if  srv
            lws1p      =   line.new    (x1 = wyt , y1  =   WS1  , x2 = wtt , y2    =   WS1,     xloc = xloc.bar_time, extend=extend.none,   color   =   clr)
            line.delete(lws1p[1])
            lblws1p  =   label.new   (x = wtt , y = WS1, text = "S1W" ,                         xloc = xloc.bar_time,                       color   =   LblBR,    style   =   label.style_label_left)
            label.delete(lblws1p[1])
            lwr1p      =   line.new    (x1 = wyt , y1  =   WR1  , x2 = wtt , y2    =   WR1,     xloc = xloc.bar_time, extend=extend.none,   color   =   clr)
            line.delete(lwr1p[1])
            lblwr1p  =   label.new   (x = wtt , y = WR1, text = "R1W" ,                         xloc = xloc.bar_time,                       color   =   LblBR,    style   =   label.style_label_left)
            label.delete(lblwr1p[1])
    if mp   and (timeframe.isintraday or timeframe.isdaily or timeframe.isweekly)
        lmpp      =   line.new    (x1 = myt , y1  =   FPm  , x2 = mtt , y2          =   FPm,    xloc = xloc.bar_time, extend=extend.none,   color   =   clr,    width   =   3)
        line.delete(lmpp[1])
        lblmpp  =   label.new   (x = mtt , y = FPm, text = "PPM" ,                              xloc = xloc.bar_time,                       color   =   LblBR,    style   =   label.style_label_left)
        label.delete(lblmpp[1])
        if  srv
            lms1p      =   line.new    (x1 = myt , y1  =   MS1  , x2 = mtt , y2    =   MS1,     xloc = xloc.bar_time, extend=extend.none,   color   =   clr)
            line.delete(lms1p[1])
            lblms1p  =   label.new   (x = mtt , y = MS1, text = "S1M" ,                         xloc = xloc.bar_time,                       color   =   LblBR,    style   =   label.style_label_left)
            label.delete(lblms1p[1])
            lmr1p      =   line.new    (x1 = myt , y1  =   MR1  , x2 = mtt , y2    =   MR1,     xloc = xloc.bar_time, extend=extend.none,   color   =   clr)
            line.delete(lmr1p[1])
            lblmr1p  =   label.new   (x = mtt , y = MR1, text = "R1M" ,                         xloc = xloc.bar_time,                       color   =   LblBR,    style   =   label.style_label_left)
            label.delete(lblmr1p[1])
    if month == 12
        lypp      =   line.new    (x1 = myt , y1  =   FPy  , x2 = mtt , y2          =   FPy,    xloc = xloc.bar_time, extend=extend.none,   color   =   clyp,    width   =   3)
        line.delete(lypp[1])
        lblypp  =   label.new   (x = mtt , y = FPy, text = "PPY" ,                              xloc = xloc.bar_time,                       color   =   LblBR,    style   =   label.style_label_left)
        label.delete(lblypp[1])
        if  srv
            lys1p      =   line.new    (x1 = myt , y1  =   YS1  , x2 = mtt , y2    =   YS1,     xloc = xloc.bar_time, extend=extend.none,   color   =   clyp)
            line.delete(lys1p[1])
            lblys1p  =   label.new   (x = mtt , y = YS1, text = "S1Y" ,                         xloc = xloc.bar_time,                       color   =   LblBR,    style   =   label.style_label_left)
            label.delete(lblys1p[1])
            lyr1p      =   line.new    (x1 = myt , y1  =   YR1  , x2 = mtt , y2    =   YR1,     xloc = xloc.bar_time, extend=extend.none,   color   =   clyp)
            line.delete(lyr1p[1])
            lblyr1p  =   label.new   (x = mtt , y = YR1, text = "R1Y" ,                         xloc = xloc.bar_time,                       color   =   LblBR,    style   =   label.style_label_left)
            label.delete(lblyr1p[1])

//=============================================================================
// СТРУКТУРА OKO — собственная реализация
// Спецификация: docs/STRUCTURE_KERNEL_SPEC.md (та же, что у core/structure в Python).
// Заменяет блок SMC, стоявший в v163 со строки 1139. Подписи сломов: старший масштаб —
// «CHoCH»/«BOS», младший — «choch»/«bos» (для автоматической сверки с Python по меткам).
//=============================================================================
string K_G_ST  = "Структура OKO"
string K_G_OB  = "Блоки заявок"
string K_G_EQ  = "Равные уровни"
string K_G_GAP = "Разрывы (FVG)"
string K_G_RZ  = "Полосы диапазона"
string K_G_PER = "Хаи и лои периодов"

kStShow     = input.bool(true, "Показать структуру", group = K_G_ST)
kMajorLen   = input.int(50, "Старший масштаб, баров", minval = 2, group = K_G_ST)
kMinorLen   = input.int(5, "Младший масштаб, баров", minval = 2, group = K_G_ST)
kShowMinor  = input.bool(true, "Сломы младшего масштаба", group = K_G_ST)
kShowLeg    = input.bool(true, "Верх и низ ноги", group = K_G_ST)
kUpCol      = input.color(#26A69A, "Вверх", inline = "kst", group = K_G_ST)
kDnCol      = input.color(#EF5350, "Вниз", inline = "kst", group = K_G_ST)
kParityInfo = input.bool(false, "Сведения для сверки с Python", group = K_G_ST,
  tooltip = "Показывает время первого бара графика и число баров: scripts/structure_parity_pine.py считает структуру с того же бара")

kObShow     = input.bool(true, "Показать блоки", group = K_G_OB)
kObLen      = input.int(50, "Масштаб уровней, баров", minval = 2, group = K_G_OB)
kObKeep     = input.int(5, "Последних блоков каждой стороны", minval = 1, maxval = 20, group = K_G_OB)
kObUpCol    = input.color(color.new(#2962FF, 80), "Поддержка", inline = "kob", group = K_G_OB)
kObDnCol    = input.color(color.new(#F23645, 80), "Сопротивление", inline = "kob", group = K_G_OB)

kEqShow     = input.bool(true, "Показать равные уровни", group = K_G_EQ)
kEqLen      = input.int(3, "Окно точки, баров", minval = 1, group = K_G_EQ)
kEqTol      = input.float(0.1, "Допуск, доля ATR", minval = 0, step = 0.05, group = K_G_EQ)

kGapShow    = input.bool(true, "Показать разрывы", group = K_G_GAP)
kGapAuto    = input.bool(true, "Порог авто (2 × среднее)", group = K_G_GAP)
kGapFixed   = input.float(0.0, "Порог вручную, %", minval = 0, step = 0.05, group = K_G_GAP)
kGapDrop    = input.bool(true, "Убирать закрытые", group = K_G_GAP)
kGapUpCol   = input.color(color.new(#00897B, 75), "Вверх", inline = "kgp", group = K_G_GAP)
kGapDnCol   = input.color(color.new(#C2185B, 75), "Вниз", inline = "kgp", group = K_G_GAP)

kRzShow     = input.bool(false, "Показать полосы", group = K_G_RZ)
kRzBand     = input.float(5.0, "Ширина крайней полосы, %", minval = 1, maxval = 25, group = K_G_RZ) / 100

kPerD       = input.bool(false, "День", inline = "kpr", group = K_G_PER)
kPerW       = input.bool(false, "Неделя", inline = "kpr", group = K_G_PER)
kPerM       = input.bool(false, "Месяц", inline = "kpr", group = K_G_PER)

string K_G_LAY = "Слои OKO"
kOteShow    = input.bool(true, "OTE на ноге (0.5–0.79)", group = K_G_LAY)
kTgtShow    = input.bool(true, "Цель по пивотам дня", group = K_G_LAY)
kTgtMode    = input.string("Логика Егора", "Правило цели", options = ["Логика Егора", "Второй пивот"], group = K_G_LAY,
  tooltip = "Логика Егора: внутри S1–R1 → R1/S1, за ними → R2/S2 и дальше. Второй пивот — как боевой impulse_fib 1h.")
kDcShow     = input.bool(false, "Ноги Directional Change", group = K_G_LAY)
kDcMult     = input.float(3.0, "Порог DC, × ATR", minval = 0.5, step = 0.5, inline = "kdc", group = K_G_LAY)
kDcLen      = input.int(43, "ATR", minval = 2, inline = "kdc", group = K_G_LAY)

//-----------------------------------------------------------------------------
// Типы
//-----------------------------------------------------------------------------
type KLevel
    float price
    int   bar
    bool  armed = false

// Масштаб: направление, вид последней зафиксированной точки (1 вершина, -1 впадина;
// начальное соглашение — вершина), последние вершина и впадина.
type KScale
    int    dir  = 0
    int    last = 1
    KLevel hi
    KLevel lo

type KZone
    box   area
    float top
    float bottom
    bool  up
    int   born              // бар, на котором зона стала известна
    bool  gone = false

//-----------------------------------------------------------------------------
// Функции
//-----------------------------------------------------------------------------
// ATR Уайлдера, начатый с первого истинного диапазона (как в Python-ядре).
kWilder(int len) =>
    float tr = na(close[1]) ? high - low : math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
    var float smooth = na
    smooth := na(smooth) ? tr : (1.0 - 1.0 / len) * smooth + (1.0 / len) * tr
    smooth

// Кандидат в опорную точку len баров назад: 1 вершина, -1 впадина, 0 нет (вершина приоритетнее).
kPivotKind(int len) =>
    float newerHi = ta.highest(high, len)
    float newerLo = ta.lowest(low, len)
    high[len] > newerHi ? 1 : low[len] < newerLo ? -1 : 0

// Фиксирует точку, если её вид сменился; возвращает true при фиксации.
kAccept(KScale s, int kind, int len) =>
    bool fresh = kind != 0 and kind != s.last
    if fresh
        s.last := kind
        if kind == 1
            s.hi := KLevel.new(high[len], bar_index - len, true)
        else
            s.lo := KLevel.new(low[len], bar_index - len, true)
    fresh

kDrawBreak(KLevel lv, bool up, bool reversal, bool minor) =>
    color kCol = up ? kUpCol : kDnCol
    line.new(lv.bar, lv.price, bar_index, lv.price, color = kCol,
      style = minor ? line.style_dashed : line.style_solid, width = minor ? 1 : 2)
    string txt = reversal ? (minor ? "choch" : "CHoCH") : (minor ? "bos" : "BOS")
    label.new(int(math.avg(lv.bar, bar_index)), lv.price, txt, color = color(na), textcolor = kCol,
      style = up ? label.style_label_down : label.style_label_up, size = minor ? size.tiny : size.small)

// Сломы масштаба по закрытию. senior — старший масштаб: совпавший с ним уровень принадлежит ему.
kBreaks(KScale s, KScale senior, bool minor, bool draw) =>
    bool upHit = false
    bool upRev = false
    bool dnHit = false
    bool dnRev = false
    if not na(s.hi)
        if s.hi.armed and close[1] <= s.hi.price and close > s.hi.price
            bool mine = true
            if minor and not na(senior.hi)
                mine := senior.hi.price != s.hi.price
            if mine
                upHit := true
                upRev := s.dir < 0
                s.hi.armed := false
                s.dir := 1
                if draw
                    kDrawBreak(s.hi, true, upRev, minor)
    if not na(s.lo)
        if s.lo.armed and close[1] >= s.lo.price and close < s.lo.price
            bool mine = true
            if minor and not na(senior.lo)
                mine := senior.lo.price != s.lo.price
            if mine
                dnHit := true
                dnRev := s.dir > 0
                s.lo.armed := false
                s.dir := -1
                if draw
                    kDrawBreak(s.lo, false, dnRev, minor)
    [upHit, upRev, dnHit, dnRev]

// Точка с окном k с обеих сторон: слева строго хуже, справа не лучше.
kTwoSided(int k, bool highs) =>
    float olderHi = ta.highest(high[k + 1], k)
    float newerHi = ta.highest(high, k)
    float olderLo = ta.lowest(low[k + 1], k)
    float newerLo = ta.lowest(low, k)
    highs ? (olderHi < high[k] and newerHi <= high[k]) : (olderLo > low[k] and newerLo >= low[k])

kKeepLast(array<KZone> zones, int keep) =>
    while array.size(zones) > keep
        KZone old = array.shift(zones)
        if not na(old.area)
            box.delete(old.area)

//-----------------------------------------------------------------------------
// Структура на двух масштабах
//-----------------------------------------------------------------------------
var KScale kMajor = KScale.new()
var KScale kMinor = KScale.new()
var float kLegTop = na
var int   kLegTopBar = na
var float kLegBot = na
var int   kLegBotBar = na

int kMajorKind = kPivotKind(kMajorLen)
int kMinorKind = kPivotKind(kMinorLen)
if kAccept(kMajor, kMajorKind, kMajorLen)
    if kMajorKind == 1
        kLegTop := kMajor.hi.price
        kLegTopBar := kMajor.hi.bar
    else
        kLegBot := kMajor.lo.price
        kLegBotBar := kMajor.lo.bar
kAccept(kMinor, kMinorKind, kMinorLen)

if na(kLegTop) or high > kLegTop
    kLegTop := high
    kLegTopBar := bar_index
if na(kLegBot) or low < kLegBot
    kLegBot := low
    kLegBotBar := bar_index

[kMinUp, kMinUpRev, kMinDn, kMinDnRev] = kBreaks(kMinor, kMajor, true, kStShow and kShowMinor)
[kMajUp, kMajUpRev, kMajDn, kMajDnRev] = kBreaks(kMajor, kMajor, false, kStShow)

var line  kTopLine = na
var line  kBotLine = na
var label kTopLab = na
var label kBotLab = na
if barstate.islast and kStShow and kShowLeg
    line.delete(kTopLine)
    line.delete(kBotLine)
    label.delete(kTopLab)
    label.delete(kBotLab)
    kTopLine := line.new(kLegTopBar, kLegTop, bar_index + 5, kLegTop, color = kDnCol, style = line.style_dotted)
    kBotLine := line.new(kLegBotBar, kLegBot, bar_index + 5, kLegBot, color = kUpCol, style = line.style_dotted)
    kTopLab := label.new(bar_index + 5, kLegTop, "верх ноги", color = color(na), textcolor = kDnCol,
      style = label.style_label_left, size = size.tiny)
    kBotLab := label.new(bar_index + 5, kLegBot, "низ ноги", color = color(na), textcolor = kUpCol,
      style = label.style_label_left, size = size.tiny)

//-----------------------------------------------------------------------------
// Блоки заявок: сломы одного масштаба (закрытие за уровнем, один слом за бар)
//-----------------------------------------------------------------------------
float kAtr200 = kWilder(200)
var KScale kObScale = KScale.new()
int kObKind = kPivotKind(kObLen)
kAccept(kObScale, kObKind, kObLen)

var array<KZone> kObUp = array.new<KZone>()
var array<KZone> kObDn = array.new<KZone>()
bool kObFlipUp = false
bool kObFlipDn = false

kPickBlock(int fromBar, bool up) =>
    int span = bar_index - fromBar
    int pick = na
    float best = na
    if span >= 1
        for off = span to 0 by -1
            float lim = na(kAtr200[off]) ? na : 2 * kAtr200[off]
            bool calm = na(lim) or (high[off] - low[off]) < lim
            if calm
                float v = up ? low[off] : high[off]
                if na(best) or (up ? v < best : v > best)
                    best := v
                    pick := off
    pick

// один слом за бар, вверх проверяется первым (вложенные if: в Pine v5 «and» не ленивый)
bool kObUpHit = false
if not na(kObScale.hi)
    if kObScale.hi.armed and close > kObScale.hi.price
        kObUpHit := true
bool kObDnHit = false
if not kObUpHit and not na(kObScale.lo)
    if kObScale.lo.armed and close < kObScale.lo.price
        kObDnHit := true

int kObFrom = na
if kObUpHit
    kObFrom := kObScale.hi.bar
    kObScale.hi.armed := false
    kObScale.dir := 1
else if kObDnHit
    kObFrom := kObScale.lo.bar
    kObScale.lo.armed := false
    kObScale.dir := -1

// вызывается на каждом баре (требование Pine к функциям с историей); вне слома отрезок пуст
int kObPick = kPickBlock(na(kObFrom) ? bar_index : kObFrom, kObUpHit)
if not na(kObFrom)
    int off = kObPick
    if not na(off)
        float bTop = high[off]
        float bBot = low[off]
        box area = kObShow ? box.new(bar_index - off, bTop, bar_index, bBot, border_color = color(na),
          bgcolor = kObUpHit ? kObUpCol : kObDnCol) : na
        KZone z = KZone.new(area, bTop, bBot, kObUpHit, bar_index)
        if kObUpHit
            array.push(kObUp, z)
            kKeepLast(kObUp, kObKeep)
        else
            array.push(kObDn, z)
            kKeepLast(kObDn, kObKeep)

// блок пробит закрытием за дальней границей → меняет роль (поддержка ↔ сопротивление)
if array.size(kObUp) > 0
    for z in kObUp
        if not z.gone and bar_index > z.born and close < z.bottom
            z.gone := true
            kObFlipUp := true
            if not na(z.area)
                box.set_bgcolor(z.area, kObDnCol)
                box.set_border_style(z.area, line.style_dashed)
        if not z.gone and not na(z.area)
            box.set_right(z.area, bar_index)
if array.size(kObDn) > 0
    for z in kObDn
        if not z.gone and bar_index > z.born and close > z.top
            z.gone := true
            kObFlipDn := true
            if not na(z.area)
                box.set_bgcolor(z.area, kObUpCol)
                box.set_border_style(z.area, line.style_dashed)
        if not z.gone and not na(z.area)
            box.set_right(z.area, bar_index)

//-----------------------------------------------------------------------------
// Равные уровни
//-----------------------------------------------------------------------------
bool kEqHiNow = kTwoSided(kEqLen, true)
bool kEqLoNow = kTwoSided(kEqLen, false)
var float kEqHiPrice = na
var int   kEqHiBar = na
var float kEqLoPrice = na
var int   kEqLoBar = na
float kEqAllowed = na(kAtr200[kEqLen]) ? 0.0 : kEqTol * kAtr200[kEqLen]
if kEqHiNow
    float kEqP = high[kEqLen]
    int   kEqB = bar_index - kEqLen
    if not na(kEqHiPrice) and math.abs(kEqP - kEqHiPrice) < kEqAllowed and kEqShow
        line.new(kEqHiBar, kEqHiPrice, kEqB, kEqP, color = kDnCol, style = line.style_dotted)
        label.new(int(math.avg(kEqHiBar, kEqB)), kEqP, "EQH", color = color(na), textcolor = kDnCol,
          style = label.style_label_down, size = size.tiny)
    kEqHiPrice := kEqP
    kEqHiBar := kEqB
if kEqLoNow
    float kEqP = low[kEqLen]
    int   kEqB = bar_index - kEqLen
    if not na(kEqLoPrice) and math.abs(kEqP - kEqLoPrice) < kEqAllowed and kEqShow
        line.new(kEqLoBar, kEqLoPrice, kEqB, kEqP, color = kUpCol, style = line.style_dotted)
        label.new(int(math.avg(kEqLoBar, kEqB)), kEqP, "EQL", color = color(na), textcolor = kUpCol,
          style = label.style_label_up, size = size.tiny)
    kEqLoPrice := kEqP
    kEqLoBar := kEqB

//-----------------------------------------------------------------------------
// Разрывы справедливой цены (три свечи), порог причинный
//-----------------------------------------------------------------------------
bool  kGapUp = low > high[2] and close[1] > high[2]
bool  kGapDn = not kGapUp and high < low[2] and close[1] < low[2]
float kGapSpan = bar_index >= 2 ? math.max(0.0, low - high[2], low[2] - high) : 0.0
var float kGapSum = 0.0
kGapSum += close != 0 ? kGapSpan / close * 100 : 0.0
float kGapLimit = kGapAuto ? kGapSum / math.max(bar_index - 1, 1) * 2.0 : kGapFixed
float kGapSize = kGapUp ? (low - high[2]) / high[2] * 100 : kGapDn ? (low[2] - high) / high * 100 : na

var array<KZone> kGaps = array.new<KZone>()
bool kGapNew = false
if (kGapUp or kGapDn) and kGapSize > kGapLimit
    kGapNew := true
    float gTop = kGapUp ? low : low[2]
    float gBot = kGapUp ? high[2] : high
    box area = kGapShow ? box.new(bar_index - 2, gTop, bar_index, gBot, border_color = color(na),
      bgcolor = kGapUp ? kGapUpCol : kGapDnCol) : na
    array.push(kGaps, KZone.new(area, gTop, gBot, kGapUp, bar_index))
    kKeepLast(kGaps, 100)

if array.size(kGaps) > 0
    for z in kGaps
        if not z.gone and bar_index > z.born and (z.up ? close < z.bottom : close > z.top)
            z.gone := true
            if kGapDrop and not na(z.area)
                box.delete(z.area)
        if not z.gone and not na(z.area)
            box.set_right(z.area, bar_index)

//-----------------------------------------------------------------------------
// Полосы диапазона ноги
//-----------------------------------------------------------------------------
var box kRzTop = na
var box kRzMid = na
var box kRzBot = na
if barstate.islast and kRzShow and not na(kLegTop) and not na(kLegBot)
    box.delete(kRzTop)
    box.delete(kRzMid)
    box.delete(kRzBot)
    int left = math.min(kLegTopBar, kLegBotBar)
    float half = kRzBand / 2
    kRzTop := box.new(left, kLegTop, bar_index, kLegTop * (1 - kRzBand) + kLegBot * kRzBand,
      border_color = color(na), bgcolor = color.new(kDnCol, 85))
    kRzMid := box.new(left, kLegTop * (0.5 + half) + kLegBot * (0.5 - half), bar_index,
      kLegTop * (0.5 - half) + kLegBot * (0.5 + half), border_color = color(na), bgcolor = color.new(color.gray, 85))
    kRzBot := box.new(left, kLegBot * (1 - kRzBand) + kLegTop * kRzBand, bar_index, kLegBot,
      border_color = color(na), bgcolor = color.new(kUpCol, 85))

//-----------------------------------------------------------------------------
// Хаи и лои прошлых периодов (без перерисовки: значение закрытого периода)
//-----------------------------------------------------------------------------
kPrevRange(string tf) =>
    request.security(syminfo.tickerid, tf, [high[1], low[1]], lookahead = barmerge.lookahead_on)

[kDh, kDl] = kPrevRange("D")
[kWh, kWl] = kPrevRange("W")
[kMh, kMl] = kPrevRange("M")

kPeriodLine(bool on, float h, float l, string tag) =>
    var line hi = na
    var line lo = na
    var label hl = na
    var label ll = na
    if barstate.islast and on
        line.delete(hi)
        line.delete(lo)
        label.delete(hl)
        label.delete(ll)
        hi := line.new(bar_index - 20, h, bar_index + 10, h, color = color.gray, style = line.style_dashed)
        lo := line.new(bar_index - 20, l, bar_index + 10, l, color = color.gray, style = line.style_dashed)
        hl := label.new(bar_index + 10, h, tag + "↑", color = color(na), textcolor = color.gray,
          style = label.style_label_left, size = size.tiny)
        ll := label.new(bar_index + 10, l, tag + "↓", color = color(na), textcolor = color.gray,
          style = label.style_label_left, size = size.tiny)

kPeriodLine(kPerD, kDh, kDl, "Д")
kPeriodLine(kPerW, kWh, kWl, "Н")
kPeriodLine(kPerM, kMh, kMl, "М")

//-----------------------------------------------------------------------------
// Слои OKO: нога → OTE (канон проекта 0.5–0.79, уровни 0.5/0.62/0.705/0.79 — core/smc/fibonacci.py)
//-----------------------------------------------------------------------------
// Нога старшего масштаба: от последней точки против направления (или края ноги) до экстремума ноги.
int   kLegDir = 0
float kLegO = na
int   kLegOB = na
float kLegE = na
int   kLegEB = na
if kMajor.dir == 1 and not na(kLegTop)
    float kO = na(kMajor.lo) ? kLegBot : kMajor.lo.price
    int   kOb = na(kMajor.lo) ? kLegBotBar : kMajor.lo.bar
    if not na(kO) and kO < kLegTop
        kLegDir := 1
        kLegO := kO
        kLegOB := kOb
        kLegE := kLegTop
        kLegEB := kLegTopBar
else if kMajor.dir == -1 and not na(kLegBot)
    float kO = na(kMajor.hi) ? kLegTop : kMajor.hi.price
    int   kOb = na(kMajor.hi) ? kLegTopBar : kMajor.hi.bar
    if not na(kO) and kO > kLegBot
        kLegDir := -1
        kLegO := kO
        kLegOB := kOb
        kLegE := kLegBot
        kLegEB := kLegBotBar

kOteAt(float r) => kLegE - (kLegE - kLegO) * r
float kOteNear = kLegDir != 0 ? kOteAt(0.5) : na
float kOteFar  = kLegDir != 0 ? kOteAt(0.79) : na

var box   kOteBox = na
var line  kOte62 = na
var line  kOte705 = na
var label kOteLab = na
if barstate.islast
    box.delete(kOteBox)
    line.delete(kOte62)
    line.delete(kOte705)
    label.delete(kOteLab)
    if kOteShow and kLegDir != 0
        color kOc = kLegDir == 1 ? kUpCol : kDnCol
        kOteBox := box.new(kLegEB, math.max(kOteNear, kOteFar), bar_index + 10, math.min(kOteNear, kOteFar),
          border_color = color.new(kOc, 40), bgcolor = color.new(kOc, 88))
        kOte62 := line.new(kLegEB, kOteAt(0.62), bar_index + 10, kOteAt(0.62), color = color.new(kOc, 30), style = line.style_dotted)
        kOte705 := line.new(kLegEB, kOteAt(0.705), bar_index + 10, kOteAt(0.705), color = kOc, style = line.style_dashed)
        kOteLab := label.new(bar_index + 10, kOteAt(0.705), "OTE 0.705", color = color(na), textcolor = kOc,
          style = label.style_label_left, size = size.tiny)

//-----------------------------------------------------------------------------
// Слои OKO: цель по пивотам прошлого дня (формула проекта calculate_pivot_points)
//-----------------------------------------------------------------------------
[kPdH, kPdL, kPdC] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)

kPivots(float h, float l, float c) =>
    float pp = (h + l + c) / 3.0
    float hl = h - l
    array<string> names = array.from("S5", "S4", "S3", "S2", "S1", "PP", "R1", "R2", "R3", "R4", "R5")
    array<float> vals = array.from(pp * 4 - (4 * h - l), pp * 3 - (3 * h - l), pp * 2 - (2 * h - l), pp - hl,
      pp * 2.003 - h, pp, pp * 1.997 - l, pp + hl, pp * 2 + (h - 2 * l), pp * 3 + (h - 3 * l), pp * 4 + (h - 4 * l))
    [names, vals]

// Возвращает [имя, цена] цели или ["", na]. Запас 0.3% — как в замере и в боевом impulse_fib.
kPivotTarget(array<string> names, array<float> vals, float entry, bool isLong, bool egor) =>
    string tName = ""
    float  tPrice = na
    float  lim = isLong ? entry * 1.003 : entry * 0.997
    if egor
        array<string> seq = isLong ? array.from("R1", "R2", "R3", "R4", "R5") : array.from("S1", "S2", "S3", "S4", "S5")
        for nm in seq
            float v = array.get(vals, array.indexof(names, nm))
            if na(tPrice) and (isLong ? v > lim : v < lim)
                tName := nm
                tPrice := v
    else
        int seen = 0
        array<int> kIdx = array.sort_indices(vals, isLong ? order.ascending : order.descending)
        for j in kIdx
            float v = array.get(vals, j)
            if isLong ? v > lim : v < lim
                seen += 1
                if seen == 2 and na(tPrice)
                    tName := array.get(names, j)
                    tPrice := v
    [tName, tPrice]

var line  kTgtLine = na
var label kTgtLab = na
string kTgtName = ""
float  kTgtPrice = na
if barstate.islast
    line.delete(kTgtLine)
    label.delete(kTgtLab)
    if kLegDir != 0 and not na(kPdH)
        [kPn, kPv] = kPivots(kPdH, kPdL, kPdC)
        [kTn, kTp] = kPivotTarget(kPn, kPv, close, kLegDir == 1, kTgtMode == "Логика Егора")
        kTgtName := kTn
        kTgtPrice := kTp
        if kTgtShow and not na(kTp)
            color kTc = kLegDir == 1 ? kUpCol : kDnCol
            kTgtLine := line.new(bar_index - 20, kTp, bar_index + 15, kTp, color = kTc, width = 2)
            kTgtLab := label.new(bar_index + 15, kTp, "цель " + kTn, color = color(na), textcolor = kTc,
              style = label.style_label_left, size = size.small)

//-----------------------------------------------------------------------------
// Слои OKO: ноги Directional Change — порог в ATR (core/smc/dc_legs.py: экстремум по фитилю,
// подтверждение по закрытию; начало следующей ноги — крайний бар участка до подтверждения)
//-----------------------------------------------------------------------------
float kDcAtr = kWilder(kDcLen)
var bool  kDcUp = true
var float kDcMax = na
var int   kDcMaxB = na
var float kDcMin = na
var int   kDcMinB = na
var float kDcPrevP = na
var int   kDcPrevB = na

kDcSegment(int fromBar, bool wantMin) =>
    int span = bar_index - fromBar
    int pick = na
    float best = na
    for off = span to 0 by -1
        float v = wantMin ? low[off] : high[off]
        if na(best) or (wantMin ? v < best : v > best)
            best := v
            pick := off
    [best, bar_index - pick]

bool  kDcConfUp = false
bool  kDcConfDn = false
float kDcExtP = na
int   kDcExtB = na
if bar_index == 0
    kDcMax := high
    kDcMaxB := 0
    kDcMin := low
    kDcMinB := 0
else
    float kThr = kDcAtr * kDcMult
    if kDcUp
        if high > kDcMax
            kDcMax := high
            kDcMaxB := bar_index
        else if close < kDcMax - kThr
            kDcConfUp := true
            kDcExtP := kDcMax
            kDcExtB := kDcMaxB
    else
        if low < kDcMin
            kDcMin := low
            kDcMinB := bar_index
        else if close > kDcMin + kThr
            kDcConfDn := true
            kDcExtP := kDcMin
            kDcExtB := kDcMinB

[kDcSegP, kDcSegB] = kDcSegment(kDcConfUp ? kDcMaxB : kDcConfDn ? kDcMinB : bar_index, kDcConfUp)
if kDcConfUp or kDcConfDn
    if kDcShow
        color kDcc = kDcConfUp ? kDnCol : kUpCol
        if not na(kDcPrevP)
            line.new(kDcPrevB, kDcPrevP, kDcExtB, kDcExtP, color = color.new(kDcc, 20), width = 2)
        label.new(kDcExtB, kDcExtP, kDcConfUp ? "kDcc+" : "kDcc-", color = color(na), textcolor = kDcc,
          style = kDcConfUp ? label.style_label_down : label.style_label_up, size = size.tiny)
    kDcPrevP := kDcExtP
    kDcPrevB := kDcExtB
    if kDcConfUp
        kDcUp := false
        kDcMin := kDcSegP
        kDcMinB := kDcSegB
    else
        kDcUp := true
        kDcMax := kDcSegP
        kDcMaxB := kDcSegB

//-----------------------------------------------------------------------------
// Сведения для сверки с Python: первый бар графика, число баров, нога, OTE, цель
//-----------------------------------------------------------------------------
var int   kFirstTime = time
var table kInfo = na
if barstate.islast and kParityInfo
    if na(kInfo)
        kInfo := table.new(position.bottom_right, 1, 3)
    string kF8 = "#.########"
    table.cell(kInfo, 0, 0, "OKO t0=" + str.tostring(kFirstTime) + " n=" + str.tostring(bar_index + 1),
      text_color = color.gray, text_size = size.tiny)
    table.cell(kInfo, 0, 1, "leg=" + str.tostring(kLegDir) + " o=" + str.tostring(kLegO, kF8) + " e=" + str.tostring(kLegE, kF8)
      + " ote=" + str.tostring(kOteNear, kF8) + "/" + str.tostring(kOteFar, kF8), text_color = color.gray, text_size = size.tiny)
    table.cell(kInfo, 0, 2, "tgt=" + kTgtName + "@" + str.tostring(kTgtPrice, kF8) + " close=" + str.tostring(close, kF8)
      + " piv=" + str.tostring(kPdH, kF8) + "/" + str.tostring(kPdL, kF8) + "/" + str.tostring(kPdC, kF8),
      text_color = color.gray, text_size = size.tiny)

//-----------------------------------------------------------------------------
// Оповещения
//-----------------------------------------------------------------------------
alertcondition(kMajUp and kMajUpRev, "OKO: CHoCH вверх", "OKO: разворот вверх (старший масштаб)")
alertcondition(kMajUp and not kMajUpRev, "OKO: BOS вверх", "OKO: продолжение вверх (старший масштаб)")
alertcondition(kMajDn and kMajDnRev, "OKO: CHoCH вниз", "OKO: разворот вниз (старший масштаб)")
alertcondition(kMajDn and not kMajDnRev, "OKO: BOS вниз", "OKO: продолжение вниз (старший масштаб)")
alertcondition(kMinUp or kMinDn, "OKO: слом младшего масштаба", "OKO: слом младшего масштаба")
alertcondition(kObFlipUp or kObFlipDn, "OKO: блок сменил роль", "OKO: блок заявок пробит закрытием")
alertcondition(kGapNew, "OKO: новый разрыв", "OKO: новый разрыв справедливой цены")

// ── RSI Дивергенции ──────────────────────────────────────────────────────────
grpDiv       = "Divergence Settings"
divSrc       = input.string("Close", "Pivot Source",
                             options=["Close","High/Low"],                  group=grpDiv)
divType      = input.string("Regular/Hidden", "Type",
                             options=["Regular","Hidden","Regular/Hidden"], group=grpDiv)
divMaxPP     = input.int(10,  "Max Pivot Points",   minval=1,  maxval=20,  group=grpDiv)
divMaxBars   = input.int(100, "Max Bars Back",       minval=30, maxval=200, group=grpDiv)
divNoConfirm = input.bool(false, "No Confirmation Wait",                   group=grpDiv)
divShowLines = input.bool(true,  "Show Divergence Lines",                  group=grpDiv)
divShowPivs  = input.bool(false, "Show Pivot Dots",                        group=grpDiv)
divRsiLen    = input.int(14, "RSI Period",                                 group=grpDiv)
divShowLast  = input.int(1, "Max Divergences to Show", minval=1, maxval=5, group=grpDiv,
             tooltip="1 = only last, 2 = last two, 3 = last three, etc.")

// ── ГИБКИЙ ПЕРИОД ПИВОТОВ ────────────────────────────────────────────────────
// Вместо одного фиксированного периода — диапазон min..max.
// Индикатор строит ДВА набора пивот-массивов (для min и max периода)
// и ищет дивергенцию в обоих, возвращая наиболее свежий сигнал.
// Это позволяет одновременно ловить:
//   • мелкие структуры (divPrdMin) — важно на 1m/3m/5m
//   • крупные структуры (divPrdMax) — важно на 15m/1H/4H и выше
grpDivPrd = "Divergence Pivot Period"
divPrdMin = input.int(3,  "Pivot Period Min", minval=1, maxval=20, group=grpDivPrd,
             tooltip="Minimum pivot lookback. Smaller = more sensitive, catches fast pivots on low TF")
divPrdMax = input.int(8,  "Pivot Period Max", minval=2, maxval=50, group=grpDivPrd,
             tooltip="Maximum pivot lookback. Larger = fewer but more significant pivots on high TF")
divPrdStep = input.int(1, "Step",             minval=1, maxval=5,  group=grpDivPrd,
             tooltip="Increment between min and max. Step=1 tries every period; Step=2 tries every other")
divBestOf  = input.string("Most Recent", "Select Signal By",
             options=["Most Recent","Strongest RSI Delta","Longest Wave"],  group=grpDivPrd,
             tooltip="Most Recent = closest divergence in bars. Strongest = biggest RSI gap. Longest = spans most bars.")

divColPosReg = input.color(color.yellow, "Bull Regular",  group=grpDiv)
divColNegReg = input.color(color.navy,   "Bear Regular",  group=grpDiv)
divColPosHid = input.color(color.lime,   "Bull Hidden",   group=grpDiv)
divColNegHid = input.color(color.red,    "Bear Hidden",   group=grpDiv)

divRegStyle_ = input.string("Solid",  "Regular Style",
                             options=["Solid","Dashed","Dotted"], group=grpDiv)
divHidStyle_ = input.string("Dashed", "Hidden Style",
                             options=["Solid","Dashed","Dotted"], group=grpDiv)
divRegWidth  = input.int(2, "Regular Width", minval=1, maxval=5, group=grpDiv)
divHidWidth  = input.int(1, "Hidden Width",  minval=1, maxval=5, group=grpDiv)
// =============================================================================
// РАЗДЕЛ 2 — ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// =============================================================================

strToLineStyle(s) =>
    s == "Dotted" ? line.style_dotted : s == "Dashed" ? line.style_dashed : line.style_solid

var divRegStyle = strToLineStyle(divRegStyle_)
var divHidStyle = strToLineStyle(divHidStyle_)

// =============================================================================
// РАЗДЕЛ 5 — RSI ДИВЕРГЕНЦИИ С ГИБКИМ ПЕРИОДОМ
// =============================================================================

// ── Два набора пивот-массивов: MIN-период и MAX-период ───────────────────────
// MIN — ловит быстрые пивоты (мелкие ТФ)
// MAX — ловит значимые пивоты (старшие ТФ)
// Оба обновляются ОДИН раз за бар.

var int   divArrSize = 20

// Пивоты MIN периода
var int[]   phPosMin = array.new_int(divArrSize, 0)
var float[] phValMin = array.new_float(divArrSize, 0.)
var int[]   plPosMin = array.new_int(divArrSize, 0)
var float[] plValMin = array.new_float(divArrSize, 0.)

// Пивоты MAX периода
var int[]   phPosMax = array.new_int(divArrSize, 0)
var float[] phValMax = array.new_float(divArrSize, 0.)
var int[]   plPosMax = array.new_int(divArrSize, 0)
var float[] plValMax = array.new_float(divArrSize, 0.)

// ── Функция обновления одного набора массивов ─────────────────────────────────
updatePivArr(prd, phPos, phVal, plPos, plVal) =>
    ph = ta.pivothigh(divSrc == "Close" ? close : high, prd, prd)
    pl = ta.pivotlow (divSrc == "Close" ? close : low,  prd, prd)
    if not na(ph)
        array.unshift(phPos, bar_index)
        array.unshift(phVal, ph)
        if array.size(phPos) > divArrSize
            array.pop(phPos)
            array.pop(phVal)
    if not na(pl)
        array.unshift(plPos, bar_index)
        array.unshift(plVal, pl)
        if array.size(plPos) > divArrSize
            array.pop(plPos)
            array.pop(plVal)
    [ph, pl]

// Вызываем ровно по одному разу для каждого периода
[phMin, plMin] = updatePivArr(divPrdMin, phPosMin, phValMin, plPosMin, plValMin)
[phMax, plMax] = updatePivArr(divPrdMax, phPosMax, phValMax, plPosMax, plValMax)

// ── Поиск дивергенции в конкретном наборе пивотов ────────────────────────────
// Возвращает [divlen, rsiDelta] — длину и силу дивергенции
// divlen=0 означает "не найдена"

searchBullDiv(src, cond, prd, plPos_, plVal_) =>
    divlen   = 0
    rsiDelta = 0.0
    prsc = divSrc == "Close" ? close : low
    if divNoConfirm or src > src[1] or close > close[1]
        sp = divNoConfirm ? 0 : 1
        for x = 0 to divMaxPP - 1 by 1
            len = bar_index - array.get(plPos_, x) + prd
            if array.get(plPos_, x) == 0 or len > divMaxBars
                break
            pv = nz(array.get(plVal_, x))
            condOk = cond == 1 ? (src[sp] > src[len] and prsc[sp] < pv) :
                                 (src[sp] < src[len] and prsc[sp] > pv)
            if len > 5 and condOk
                sl1 = (src[sp]       - src[len])       / (len - sp)
                sl2 = (nz(close[sp]) - nz(close[len])) / (len - sp)
                vl1 = src[sp]       - sl1
                vl2 = nz(close[sp]) - sl2
                ok  = true
                for y = 1 + sp to len - 1 by 1
                    if src[y] < vl1 or nz(close[y]) < vl2
                        ok := false
                        break
                    vl1 -= sl1
                    vl2 -= sl2
                if ok
                    divlen   := len
                    rsiDelta := math.abs(src[sp] - src[len])
                    break
    [divlen, rsiDelta]

searchBearDiv(src, cond, prd, phPos_, phVal_) =>
    divlen   = 0
    rsiDelta = 0.0
    prsc = divSrc == "Close" ? close : high
    if divNoConfirm or src < src[1] or close < close[1]
        sp = divNoConfirm ? 0 : 1
        for x = 0 to divMaxPP - 1 by 1
            len = bar_index - array.get(phPos_, x) + prd
            if array.get(phPos_, x) == 0 or len > divMaxBars
                break
            pv = nz(array.get(phVal_, x))
            condOk = cond == 1 ? (src[sp] < src[len] and prsc[sp] > pv) :
                                 (src[sp] > src[len] and prsc[sp] < pv)
            if len > 5 and condOk
                sl1 = (src[sp]       - src[len])       / (len - sp)
                sl2 = (nz(close[sp]) - nz(close[len])) / (len - sp)
                vl1 = src[sp]       - sl1
                vl2 = nz(close[sp]) - sl2
                ok  = true
                for y = 1 + sp to len - 1 by 1
                    if src[y] > vl1 or nz(close[y]) > vl2
                        ok := false
                        break
                    vl1 -= sl1
                    vl2 -= sl2
                if ok
                    divlen   := len
                    rsiDelta := math.abs(src[sp] - src[len])
                    break
    [divlen, rsiDelta]

// ── Выбор лучшего из двух результатов (MIN vs MAX) ───────────────────────────
// Стратегия выбора задаётся параметром divBestOf:
//   "Most Recent"      → меньший divlen (ближе по барам)
//   "Strongest RSI Delta" → больший rsiDelta (сильнее расхождение)
//   "Longest Wave"     → больший divlen (охватывает больше баров)

selectBest(len1, delta1, len2, delta2) =>
    // Если один не найден — берём другой
    if len1 == 0 and len2 == 0
        [0, 0.0]
    else if len1 == 0
        [len2, delta2]
    else if len2 == 0
        [len1, delta1]
    else
        // Оба найдены — выбираем по стратегии
        useFirst = divBestOf == "Most Recent"         ? len1 <= len2 :
                 divBestOf == "Strongest RSI Delta" ? delta1 >= delta2 :
                 len1 >= len2  // Longest Wave
        if useFirst
            [len1, delta1]
        else
            [len2, delta2]

// ── Расчёт всех 4 типов дивергенций ──────────────────────────────────────────
rsiVal = ta.rsi(close, divRsiLen)

doRegular = divType == "Regular" or divType == "Regular/Hidden"
doHidden  = divType == "Hidden"  or divType == "Regular/Hidden"

// ИСПРАВЛЕНИЕ: тернарник не может возвращать кортежи в Pine v6 — используем if/else

// Бычьи Regular
[posRegMin, posRegDeltaMin] = if doRegular
    searchBullDiv(rsiVal, 1, divPrdMin, plPosMin, plValMin)
else
    [0, 0.0]
[posRegMax, posRegDeltaMax] = if doRegular
    searchBullDiv(rsiVal, 1, divPrdMax, plPosMax, plValMax)
else
    [0, 0.0]
[posReg, posRegDelta] = selectBest(posRegMin, posRegDeltaMin, posRegMax, posRegDeltaMax)

// Бычьи Hidden
[posHidMin, posHidDeltaMin] = if doHidden
    searchBullDiv(rsiVal, 2, divPrdMin, plPosMin, plValMin)
else
    [0, 0.0]
[posHidMax, posHidDeltaMax] = if doHidden
    searchBullDiv(rsiVal, 2, divPrdMax, plPosMax, plValMax)
else
    [0, 0.0]
[posHid, posHidDelta] = selectBest(posHidMin, posHidDeltaMin, posHidMax, posHidDeltaMax)

// Медвежьи Regular
[negRegMin, negRegDeltaMin] = if doRegular
    searchBearDiv(rsiVal, 1, divPrdMin, phPosMin, phValMin)
else
    [0, 0.0]
[negRegMax, negRegDeltaMax] = if doRegular
    searchBearDiv(rsiVal, 1, divPrdMax, phPosMax, phValMax)
else
    [0, 0.0]
[negReg, negRegDelta] = selectBest(negRegMin, negRegDeltaMin, negRegMax, negRegDeltaMax)

// Медвежьи Hidden
[negHidMin, negHidDeltaMin] = if doHidden
    searchBearDiv(rsiVal, 2, divPrdMin, phPosMin, phValMin)
else
    [0, 0.0]
[negHidMax, negHidDeltaMax] = if doHidden
    searchBearDiv(rsiVal, 2, divPrdMax, phPosMax, phValMax)
else
    [0, 0.0]
[negHid, negHidDelta] = selectBest(negHidMin, negHidDeltaMin, negHidMax, negHidDeltaMax)

hasBullDiv = posReg > 0 or posHid > 0
hasBearDiv = negReg > 0 or negHid > 0

// Pivot dots (показываем пивоты обоих периодов)
plotshape(divShowPivs and not na(plMin), text="l", style=shape.labelup,
     color=color.new(color.white, 100), textcolor=color.new(color.lime, 30),
     location=location.belowbar, offset=-divPrdMin, size=size.tiny)
plotshape(divShowPivs and not na(phMin), text="h", style=shape.labeldown,
     color=color.new(color.white, 100), textcolor=color.new(color.red, 30),
     location=location.abovebar, offset=-divPrdMin, size=size.tiny)
plotshape(divShowPivs and not na(plMax), text="L", style=shape.labelup,
     color=color.new(color.white, 100), textcolor=color.lime,
     location=location.belowbar, offset=-divPrdMax, size=size.small)
plotshape(divShowPivs and not na(phMax), text="H", style=shape.labeldown,
     color=color.new(color.white, 100), textcolor=color.red,
     location=location.abovebar, offset=-divPrdMax, size=size.small)

// ── Рисование линий дивергенций ───────────────────────────────────────────────
var line[] posDiv_lines = array.new_line()
var line[] negDiv_lines = array.new_line()

// Удаляем линии сверх лимита (оставляем последние divShowLast штук)
trimLines(linesArr) =>
    while array.size(linesArr) >= divShowLast
        line.delete(array.shift(linesArr))

deletePosLines() =>
    trimLines(posDiv_lines)

deleteNegLines() =>
    trimLines(negDiv_lines)

drawDivLine(divlen, divIdx, isFirstPos, isFirstNeg) =>
    sp       = divNoConfirm ? 0 : 1
    isDivPos = divIdx == 0 or divIdx == 2
    divCol   = divIdx == 0 ? divColPosReg :
               divIdx == 1 ? divColNegReg :
               divIdx == 2 ? divColPosHid : divColNegHid
    dStyle   = divIdx < 2 ? divRegStyle : divHidStyle
    dWidth   = divIdx < 2 ? divRegWidth : divHidWidth
    useClose = divSrc == "Close"
    y1src    = useClose ? close[divlen] : isDivPos ? low[divlen]  : high[divlen]
    y2src    = useClose ? close[sp]     : isDivPos ? low[sp]      : high[sp]

    if divShowLines
        // Обрезаем очередь до лимита перед добавлением новой линии
        if isDivPos and isFirstPos
            deletePosLines()
        if not isDivPos and isFirstNeg
            deleteNegLines()
        newLine = line.new(
             x1=bar_index - divlen, y1=y1src,
             x2=bar_index - sp,     y2=y2src,
             color=divCol, style=dStyle, width=dWidth)
        if isDivPos
            array.push(posDiv_lines, newLine)
        else
            array.push(negDiv_lines, newLine)

var bool drawnPos = false
var bool drawnNeg = false
drawnPos := false
drawnNeg := false

if posReg > 0
    drawDivLine(posReg, 0, not drawnPos, not drawnNeg)
    drawnPos := true

if negReg > 0
    drawDivLine(negReg, 1, not drawnPos, not drawnNeg)
    drawnNeg := true

if posHid > 0
    drawDivLine(posHid, 2, not drawnPos, not drawnNeg)
    drawnPos := true

if negHid > 0
    drawDivLine(negHid, 3, not drawnPos, not drawnNeg)
    drawnNeg := true
