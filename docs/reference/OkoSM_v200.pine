// Plotting_Scalping_Alerts//



// //HULL TREND WITH KAHLMAN

srchull         = hl2
lengthhull      = 16
gain            = 7000


hma(_srchull, _lengthhull) =>
    ta.wma((2 * ta.wma(_srchull, _lengthhull / 2)) - ta.wma(_srchull, _lengthhull), math.round(math.sqrt(_lengthhull)))
    
hma3(_srchull, _lengthhull) =>
    p = lengthhull/2
    ta.wma(ta.wma(hl2,p/3)*3 - ta.wma(hl2,p/2) - ta.wma(hl2,p),p)

kahlman(x, g) =>
    kf = 0.0
    dk = x - nz(kf[1], x)
    smooth = nz(kf[1],x)+dk*math.sqrt((g/10000)*2)
    velo = 0.0
    velo := nz(velo[1],0) + ((g/10000)*dk)
    kf := smooth+velo
  
a = kahlman(hma(srchull, lengthhull), gain) 
b = kahlman(hma3(srchull, lengthhull), gain) 
c = b > a ? color.lime : color.red
crossdn = a > b and a[1] < b[1]
crossup = b > a and b[1] < a[1]

// plotshape(showcross and crossdn ? a : na, location=location.abovebar, style=shape.triangledown, color=color.yellow, text="", textcolor=color.white, transp=0, offset=-1)
// plotshape(showcross and crossup ? a : na, location=location.belowbar, style=shape.triangleup, color=color.blue, text="", textcolor=color.white, transp=0, offset=-1)
plotshape(scalpingAlerts and crossdn ? a : na, location=location.abovebar, style=shape.triangledown, color=color.yellow, text="", textcolor=color.white, transp=0, offset=0)
plotshape(scalpingAlerts and crossup ? a : na, location=location.belowbar, style=shape.triangleup, color=color.blue, text="", textcolor=color.white, transp=0, offset=0)



// /////////////////////////////////////////////////////// --DYNAMIC CHANNEL-- ////////////////////////////////////////////////////////

GRP4 = "Dynamic channel"
lengthInput = input.int(200, title="Length", minval = 1, maxval = 5000, inline ="Dynamic channel", group = GRP4)
sourceInput = input.source(hl2, title="Source", inline ="Dynamic channel", group = GRP4)
useUpperDevInput = input.bool(true, title="Deviation", inline = "Deviation", group = GRP4)
upperMultInput = input.float(2.0, title="", inline = "Deviation", group = GRP4)
useLowerDevInput = useUpperDevInput
lowerMultInput = upperMultInput

// group4 = "Display Settings"
extendLeftInput = input.bool(false,  title="Extend Lines Left", inline ="Lines", group = GRP4)
extendRightInput = input.bool(false,  title="Extend Lines Right", inline ="Lines", group = GRP4)
extendStyle = switch
    extendLeftInput and extendRightInput => extend.both
    extendLeftInput => extend.left
    extendRightInput => extend.right
    => extend.none

// group3 = "Color Settings"
colorUpper = input.color(color.new(color.orange, 95), "", inline = "Deviation", group = GRP4)
colorLower = colorUpper 
baseLine = colorUpper


calcSlope(source, length) =>
    max_bars_back(source, 5000)
    if not barstate.islast or length <= 1 or not showChannel
        [float(na), float(na), float(na)]
    else
        sumX = 0.0
        sumY = 0.0
        sumXSqr = 0.0
        sumXY = 0.0
        for i = 0 to length - 1 by 1
            val = source[i]
            per = i + 1.0
            sumX += per
            sumY += val
            sumXSqr += per * per
            sumXY += val * per
        slope = (length * sumXY - sumX * sumY) / (length * sumXSqr - sumX * sumX)
        average = sumY / length
        intercept = average - slope * sumX / length + slope
        [slope, average, intercept]
        
[s, aa, i] = calcSlope(sourceInput, lengthInput)
startPrice = i + s * (lengthInput - 1)
endPrice = i
var line base = na
if na(base) and not na(startPrice)
    base := line.new(bar_index - lengthInput + 1, startPrice, bar_index, endPrice, width=1, extend=extendStyle, color=color.new(baseLine, 0))
else
    line.set_xy1(base, bar_index - lengthInput + 1, startPrice)
    line.set_xy2(base, bar_index, endPrice)
    na
    
calcDev(source, length, slope, average, intercept) =>
    upDev = 0.0
    dnDev = 0.0
    stdDevAcc = 0.0
    dsxx = 0.0
    dsyy = 0.0
    dsxy = 0.0
    periods = length - 1
    daY = intercept + slope * periods / 2
    val = intercept
    for j = 0 to periods by 1
        price = high[j] - val
        if price > upDev
            upDev := price
        price := val - low[j]
        if price > dnDev
            dnDev := price
        price := source[j]
        dxt = price - average
        dyt = val - daY
        price -= val
        stdDevAcc += price * price
        dsxx += dxt * dxt
        dsyy += dyt * dyt
        dsxy += dxt * dyt
        val += slope
    stdDev = math.sqrt(stdDevAcc / (periods == 0 ? 1 : periods))
    [stdDev, upDev, dnDev]
    
[stdDev, upDev, dnDev] = calcDev(sourceInput, lengthInput, s, a, i)
upperStartPrice = startPrice + (useUpperDevInput ? upperMultInput * stdDev : upDev)
upperEndPrice = endPrice + (useUpperDevInput ? upperMultInput * stdDev : upDev)
var line upper = na
lowerStartPrice = startPrice + (useLowerDevInput ? -lowerMultInput * stdDev : -dnDev)
lowerEndPrice = endPrice + (useLowerDevInput ? -lowerMultInput * stdDev : -dnDev)
var line lower = na
if na(upper) and not na(upperStartPrice)
    upper := line.new(bar_index - lengthInput + 1, upperStartPrice, bar_index, upperEndPrice, width=1, extend=extendStyle, color=color.new(colorUpper, 0))
else
    line.set_xy1(upper, bar_index - lengthInput + 1, upperStartPrice)
    line.set_xy2(upper, bar_index, upperEndPrice)
    na
if na(lower) and not na(lowerStartPrice)
    lower := line.new(bar_index - lengthInput + 1, lowerStartPrice, bar_index, lowerEndPrice, width=1, extend=extendStyle, color=color.new(colorLower, 0))
else
    line.set_xy1(lower, bar_index - lengthInput + 1, lowerStartPrice)
    line.set_xy2(lower, bar_index, lowerEndPrice)
    na
    
// linefill.new(showChannel ? upper : na, base, color = colorUpper)
// linefill.new(showChannel ? base : na, lower, color = colorLower)


