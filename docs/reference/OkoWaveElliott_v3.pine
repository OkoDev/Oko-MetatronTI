plot(trend,    "trend",         display = display.data_window)
plot(itrend,   "itrend",        display = display.data_window)
plot(recounts, "wave_recounts", display = display.data_window)

// ─── АЛЕРТЫ ─────────────────────────────────────────────────────────────────
alertcondition(phaseChanged, "Смена волновой фазы", "OKO Wave: фаза сменилась")
alertcondition(recount,      "Пересчёт волнового счёта", "OKO Wave: счёт волн СЛОМАЛСЯ — прежняя разметка была неверной")
alertcondition(legInOte  and not legInOte[1],  "Старшая нога вошла в OTE", "OKO Wave: откат старшей ноги в 0.618–0.79")
alertcondition(mlegInOte and not mlegInOte[1], "Младшая нога вошла в OTE", "OKO Wave: откат младшей ноги в 0.618–0.79")

// ============================================================================
// БЛОК 2 — РАЗВОЛНОВКА ПО КАНОНУ IKIGAI (структуры движения и коррекции)
// Движок другой, чем в блоке 1: там структура 50/5 и одна нога (oko_sm_engine),
// здесь ZigZag + правила из гайдов Егора (docs/Гайд по структурам *.pdf).
// ============================================================================
// ─── ВХОДЫ ──────────────────────────────────────────────────────────────────
string ewGz = "ВОЛНЫ · ZigZag (порт zigzag_atr)"
zzDepth  = input.int(11, "depth (Pine length = depth/2)", minval = 2, group = ewGz)
zzAtrLen = input.int(10, "ATR length", minval = 1, group = ewGz)
showZz   = input.bool(false, "Рисовать сам ZigZag", group = ewGz)

string ewGm = "Степени волн"
s1on = input.bool(true,  "Степень 1 (младшая)", group = ewGm, inline = "1")
dev1 = input.float(3.0,  "dev", minval = 0.1, step = 0.5, group = ewGm, inline = "1")
col1 = input.color(#f23645, "", group = ewGm, inline = "1")
s2on = input.bool(true,  "Степень 2 (средняя)", group = ewGm, inline = "2")
dev2 = input.float(5.0,  "dev", minval = 0.1, step = 0.5, group = ewGm, inline = "2")
col2 = input.color(#2962ff, "", group = ewGm, inline = "2")
s3on = input.bool(true,  "Степень 3 (старшая)", group = ewGm, inline = "3")
dev3 = input.float(8.0,  "dev", minval = 0.1, step = 0.5, group = ewGm, inline = "3")
col3 = input.color(#eeeeee, "", group = ewGm, inline = "3")

string ewGs = "ВОЛНЫ · что размечать"
useImpulse  = input.bool(true, "Импульс (5 волн)", group = ewGs)
useDiagonal = input.bool(true, "Диагонали (начальная / конечная)", group = ewGs)
useTriangle = input.bool(true, "Треугольник ABCDE", group = ewGs)
useCorr3    = input.bool(true, "Зигзаг · плоскость · двойной зигзаг · комбинация", group = ewGs)
useLocal    = input.bool(true, "Проверять локальные структуры (подструктуры)", group = ewGs,
     tooltip = "Волна 3 — только импульс · волна 2 — не треугольник · в плоскости A и B —\nзигзаги · в треугольнике все волны — зигзаги. Нарушение снижает уверенность")
normTol     = input.float(0.12, "Допуск на НОРМЫ фибо", minval = 0.01, maxval = 0.5, step = 0.01, group = ewGs)

string gF = "Прогноз"
useForecast = input.bool(true, "Прогноз незавершённой структуры", group = gF)
showChannel = input.bool(true, "Каналы как цели (норма гайда)", group = gF)
showTargets = input.bool(true, "Цели по фибо-нормам", group = gF)
showInvalid = input.bool(true, "Уровень инвалидации счёта", group = gF)

string ewGd = "ВОЛНЫ · отрисовка"
maxStruct = input.int(6, "Структур в памяти на степень", minval = 1, maxval = 20, group = ewGd)
ewLineW     = input.int(3, "Толщина линий", minval = 1, maxval = 6, group = ewGd)
showTableEW = input.bool(true, "Панель состояния и прогноза", group = ewGd)


// ─── КОДЫ СТРУКТУР ──────────────────────────────────────────────────────────
// 1 импульс · 2 нач. диагональ · 3 кон. диагональ · 4 треугольник · 5 треуг. бегущий
// 10 зигзаг · 11 плоскость · 12 плоскость расш. · 13 плоскость бегущая
// 14 комбинация · 15 двойной зигзаг · 0 нет
f_structName(int c) =>
    c == 1 ? "импульс" : c == 2 ? "нач. диагональ" : c == 3 ? "кон. диагональ" :
     c == 4 ? "треугольник" : c == 5 ? "треуг. бегущий" : c == 10 ? "зигзаг" :
     c == 11 ? "плоскость" : c == 12 ? "плоскость расш." : c == 13 ? "плоскость бег." :
     c == 14 ? "комбинация" : c == 15 ? "двойной зигзаг" : "—"

f_isMotive(int c)  => c == 1 or c == 2 or c == 3
f_isZigzag(int c)  => c == 10
f_isFlat(int c)    => c == 11 or c == 12 or c == 13
f_isTriangle(int c) => c == 4 or c == 5
f_isCorr(int c)    => c >= 10

f_beyond(bool up, float price, float level) => up ? price > level : price < level
f_len(float a, float b) => math.abs(b - a)
f_near(float v, float target, float tol) => math.abs(v - target) <= tol

// ─── PIVOT (порт zigzag_atr.pivot_at) ───────────────────────────────────────
f_pivotAt(simple int length, simple bool hi) =>
    int l2 = length * 2
    float c = hi ? high[length] : low[length]
    bool ok = not na(c)
    if ok
        for k = 0 to l2
            if k != length
                float v = hi ? high[k] : low[k]
                if na(v)
                    ok := false
                else
                    bool left = k > length
                    if hi
                        if left and v >= c
                            ok := false
                        if not left and v > c
                            ok := false
                    else
                        if left and v <= c
                            ok := false
                        if not left and v < c
                            ok := false
    [ok, c, bar_index - length]

// ─── ОБНОВЛЕНИЕ ZIGZAG (массивы передаются по ссылке) ───────────────────────
f_zzUpdate(zx, zy, zh, simple int length, float devMult, simple int atrLen_) =>
    float atrv = ta.atr(atrLen_)
    float thr = not na(atrv) and close != 0 ? atrv / close * 100 * devMult : 1e9
    [okH, pH, xH] = f_pivotAt(length, true)
    [okL, pL, xL] = f_pivotAt(length, false)
    bool changed = false
    if okH or okL
        bool hiFlag = okH
        float price = okH ? pH : pL
        int   px    = okH ? xH : xL
        int n0 = array.size(zx)
        if n0 == 0
            array.push(zx, px)
            array.push(zy, price)
            array.push(zh, hiFlag)
            changed := true
        else
            bool  lastHi = array.get(zh, n0 - 1)
            float lastP  = array.get(zy, n0 - 1)
            if hiFlag == lastHi
                if (hiFlag and price > lastP) or (not hiFlag and price < lastP)
                    array.set(zy, n0 - 1, price)
                    array.set(zx, n0 - 1, px)
                    changed := true
            else
                float dv = price != 0 ? math.abs(100 * (price - lastP) / price) : 0.0
                if dv > thr
                    array.push(zx, px)
                    array.push(zy, price)
                    array.push(zh, hiFlag)
                    changed := true
        if array.size(zx) > 300
            array.shift(zx)
            array.shift(zy)
            array.shift(zh)
    changed

// ─── ПРАВИЛА: 5 НОГ (импульс · диагональ · треугольник) ─────────────────────
f_classify5(float p0, float p1, float p2, float p3, float p4, float p5,
            simple bool okImp, simple bool okDia, simple bool okTri, float tol) =>
    bool up = p1 > p0
    float w1 = f_len(p0, p1)
    float w2 = f_len(p1, p2)
    float w3 = f_len(p2, p3)
    float w4 = f_len(p3, p4)
    float w5 = f_len(p4, p5)

    int   code = 0
    float ewConf = 0.0
    string note = ""

    bool r1 = not f_beyond(not up, p2, p0)                 // волна 2 не за начало волны 1
    bool r2 = not (w3 < w1 and w3 < w5)                    // волна 3 не самая короткая
    bool r3 = not f_beyond(not up, p4, p1)                 // волна 4 не в территории волны 1
    bool impulse = okImp and r1 and r2 and r3 and f_beyond(up, p3, p1) and f_beyond(up, p5, p3)

    bool dOverlap = f_beyond(not up, p4, p1)               // волна 4 заходит на территорию волны 2
    bool dShrink  = w1 > w3 and w3 > w5 and w2 > w4
    bool diagonal = okDia and r1 and f_beyond(up, p3, p1) and dOverlap and dShrink

    bool triangle = okTri and (not f_beyond(up, p3, p1)) and (not f_beyond(not up, p4, p2)) and (not f_beyond(up, p5, p3))

    if impulse
        code := 1
        ewConf := 0.50
        float r2r = w1 > 0 ? w2 / w1 : na
        float r4r = w3 > 0 ? w4 / w3 : na
        if not na(r2r) and f_near(r2r, 0.618, tol)
            ewConf += 0.15
            note += "w2≈0.618 "
        if not na(r4r) and f_near(r4r, 0.382, tol)
            ewConf += 0.15
            note += "w4≈0.382 "
        if w1 > 0 and (f_near(w5 / w1, 1.0, tol) or (w3 > 0 and f_near(w5 / w3, 0.618, tol)))
            ewConf += 0.10
            note += "w5 в норме "
        if w1 > 0 and w3 / w1 >= 1.618
            note += "· w3 растянута "
        else if w5 > w1 and w5 > w3
            note += "· w5 растянута "
        bool sharp2 = w1 > 0 and w2 / w1 >= 0.5
        bool sharp4 = w3 > 0 and w4 / w3 >= 0.5
        if sharp2 != sharp4
            ewConf += 0.10
            note += "· чередование ✓"
        else
            note += "· чередование ✗"
    else if diagonal
        code := f_beyond(up, p5, p3) ? 2 : 3
        ewConf := 0.45
        if w1 > 0 and (f_near(w3 / w1, 0.618, tol) or f_near(w3 / w1, 0.786, tol))
            ewConf += 0.15
            note += "w3 0.618/0.786 "
        if w2 > 0 and (f_near(w4 / w2, 0.618, tol) or f_near(w4 / w2, 0.786, tol))
            ewConf += 0.15
            note += "w4 0.618/0.786 "
        if w3 > 0 and (f_near(w5 / w3, 0.618, tol) or f_near(w5 / w3, 0.786, tol))
            ewConf += 0.10
            note += "w5 0.618/0.786"
    else if triangle
        code := f_beyond(not up, p2, p0) ? 5 : 4
        ewConf := 0.45
        if w1 > 0 and (f_near(w3 / w1, 0.618, tol) or (code == 5 and f_near(w3 / w1, 1.0, tol)))
            ewConf += 0.15
            note += "C в норме "
        if w2 > 0 and f_near(w4 / w2, 0.618, tol)
            ewConf += 0.10
            note += "D в норме "
        if w3 > 0 and f_near(w5 / w3, 0.618, tol)
            ewConf += 0.15
            note += "E в норме"
    [code, math.min(ewConf, 0.95), note]

// ─── ПРАВИЛА: 3 НОГИ (зигзаг · плоскость · комбинация) ──────────────────────
f_classify3(float q0, float q1, float q2, float q3, float tol) =>
    bool  up = q1 > q0
    float A = f_len(q0, q1)
    float B = f_len(q1, q2)
    float C = f_len(q2, q3)
    float retrB = A > 0 ? B / A : na
    bool bBeyondStart = f_beyond(not up, q2, q0)
    bool cBeyondA     = f_beyond(up, q3, q1)

    int   code = 0
    float ewConf = 0.0
    string note = ""

    // верхняя граница здравого смысла: откат втрое больше волны A — это уже не плоскость
    if not na(retrB) and retrB <= 2.0
        if retrB >= 0.9
            if not bBeyondStart
                code := cBeyondA ? 11 : 14
                ewConf := cBeyondA ? 0.55 : 0.35
            else
                code := cBeyondA ? 12 : 13
                ewConf := 0.55
            if f_near(retrB, 1.236, tol) or f_near(retrB, 1.382, tol)
                ewConf += 0.15
                note += "B 1.236/1.382 "
            if A > 0 and f_near(C / A, 1.618, tol)
                ewConf += 0.15
                note += "C≈1.618·A"
            else if A > 0 and f_near(C / A, 1.0, tol)
                ewConf += 0.10
                note += "C≈A"
        else
            if not bBeyondStart and cBeyondA
                code := 10
                ewConf := 0.55
                if f_near(retrB, 0.618, tol)
                    ewConf += 0.15
                    note += "B≈0.618 "
                else if f_near(retrB, 0.382, tol)
                    note += "B≈0.382 → C ждём 0.618·A "
                if A > 0 and (f_near(C / A, 1.0, tol) or f_near(C / A, 1.618, tol))
                    ewConf += 0.15
                    note += "C 100%/162%"
    [code, math.min(ewConf, 0.95), note, retrB]

// ─── ПОДСТРУКТУРА: что младшая степень разметила внутри интервала ───────────
// Возвращает код структуры и число ног младшей степени внутри [xa, xb].
f_subCode(jx, jy, jh, int xa, int xb, simple bool okImp, simple bool okDia,
          simple bool okTri, float tol) =>
    int n = array.size(jx)
    int iFrom = -1
    int iTo = -1
    for i = 0 to (n > 0 ? n - 1 : 0)
        int x = array.get(jx, i)
        if x >= xa and iFrom == -1
            iFrom := i
        if x <= xb
            iTo := i
    int legs = (iFrom >= 0 and iTo > iFrom) ? (iTo - iFrom) : 0
    int code = 0
    if legs >= 5
        [c5, cf5, nt5] = f_classify5(array.get(jy, iTo - 5), array.get(jy, iTo - 4),
             array.get(jy, iTo - 3), array.get(jy, iTo - 2), array.get(jy, iTo - 1),
             array.get(jy, iTo), okImp, okDia, okTri, tol)
        code := c5
    if code == 0 and legs >= 3
        [ewC3, ewCf3, ewNt3, rb] = f_classify3(array.get(jy, iTo - 3), array.get(jy, iTo - 2),
             array.get(jy, iTo - 1), array.get(jy, iTo), tol)
        code := ewC3
    [code, legs]

// ─── ЛОКАЛЬНЫЕ СТРУКТУРЫ: проверка по канону ────────────────────────────────
// Движение: w1 — импульс или нач. диагональ · w3 — ТОЛЬКО импульс · w5 — импульс или
// кон. диагональ · w2 — любая коррекция КРОМЕ треугольника · w4 — любая коррекция.
// Зигзаг: A и C — движения, B — любая коррекция.
// Плоскость: A и B — зигзаг (одинарный или двойной), C — движение.
// Треугольник: A..E — зигзаги, одна волна может быть сложной.
f_localCheck(int code, int s1, int s2, int s3, int s4, int s5) =>
    bool ok = true
    string why = ""
    if code == 1
        if s3 != 0 and s3 != 1
            ok := false
            why += "w3 не импульс · "
        if s1 != 0 and not f_isMotive(s1)
            ok := false
            why += "w1 не движение · "
        if s5 != 0 and not f_isMotive(s5)
            ok := false
            why += "w5 не движение · "
        if f_isTriangle(s2)
            ok := false
            why += "w2 треугольник (запрещён) · "
    else if code == 2 or code == 3
        // диагональ: волны — зигзаги (конечная строго, начальная допускает импульсы)
        if code == 3 and (f_isMotive(s1) and s1 != 0)
            ok := false
            why += "в кон. диагонали волны — зигзаги · "
    else if f_isZigzag(code)
        if s1 != 0 and not f_isMotive(s1)
            ok := false
            why += "A зигзага не движение · "
        if s3 != 0 and not f_isMotive(s3)
            ok := false
            why += "C зигзага не движение · "
    else if f_isFlat(code)
        if s1 != 0 and f_isMotive(s1)
            ok := false
            why += "A плоскости должна быть зигзагом · "
        if s3 != 0 and not f_isMotive(s3)
            ok := false
            why += "C плоскости не движение · "
    else if f_isTriangle(code)
        int cnt = 0
        cnt := cnt + (f_isMotive(s1) ? 1 : 0) + (f_isMotive(s2) ? 1 : 0) + (f_isMotive(s3) ? 1 : 0)
        cnt := cnt + (f_isMotive(s4) ? 1 : 0) + (f_isMotive(s5) ? 1 : 0)
        if cnt > 1
            ok := false
            why += "в треугольнике волны — зигзаги · "
    [ok, why]

// ─── ЦЕНА НА КАНАЛЕ (норма гайда) ───────────────────────────────────────────
// Линия через (xa,ya)-(xb,yb), перенесённая в точку (xc,yc); значение на баре xt.
f_channelAt(int xa, float ya, int xb, float yb, int xc, float yc, int xt) =>
    float slope = xb != xa ? (yb - ya) / (xb - xa) : 0.0
    yc + slope * (xt - xc)

// ─── РАЗМЕТКА ОДНОЙ СТЕПЕНИ + ПРОГНОЗ ───────────────────────────────────────
f_mark(zx, zy, zh, jx, jy, jh, bool changed, simple bool enabled, color col,
       simple int keep, simple string sz, simple int lw,
       simple bool okImp, simple bool okDia, simple bool okTri, simple bool okC3,
       simple bool okLocal, float tol, simple bool fcast, simple bool drawChan,
       simple bool drawTgt, simple bool drawInv) =>
    var line[]  hist  = array.new_line()
    var label[] histB = array.new_label()
    var line[]  fc    = array.new_line()
    var label[] fcB   = array.new_label()

    var int    curCode = 0
    var int    curX0 = na
    var int    curLegs = 0
    var float  curConf = 0.0
    var string curNote = ""
    var int    curDir = 0
    var int    curEndX = na
    var float  curInvalid = na
    var bool   curLocalOk = true
    var string curWhy = ""
    var string fcastTxt = ""
    var float  fcastT1 = na
    var float  fcastT2 = na

    int n = array.size(zx)

    // ── 1. КЛАССИФИКАЦИЯ ЗАВЕРШЁННОЙ СТРУКТУРЫ ─────────────────────────────
    if enabled and changed and n >= 4
        int   code = 0
        float ewConf = 0.0
        string note = ""
        int   legs = 0
        int   i0 = na

        if n >= 6
            int b = n - 6
            [c5, cf5, nt5] = f_classify5(array.get(zy, b), array.get(zy, b + 1), array.get(zy, b + 2),
                 array.get(zy, b + 3), array.get(zy, b + 4), array.get(zy, b + 5), okImp, okDia, okTri, tol)
            if c5 != 0
                code := c5
                ewConf := cf5
                note := nt5
                legs := 5
                i0 := b
        if code == 0 and okC3 and n >= 4
            int b3 = n - 4
            [ewC3, ewCf3, ewNt3, rb] = f_classify3(array.get(zy, b3), array.get(zy, b3 + 1),
                 array.get(zy, b3 + 2), array.get(zy, b3 + 3), tol)
            if ewC3 != 0
                code := ewC3
                ewConf := ewCf3
                note := ewNt3
                legs := 3
                i0 := b3

        if code != 0
            int  x0 = array.get(zx, i0)
            bool isNew = (x0 != curX0 or code != curCode) and
                 (na(curEndX) or x0 >= curEndX or (legs == 5 and curLegs == 3 and x0 >= curX0))

            if isNew
                // ── ПОДСТРУКТУРЫ: что младшая степень видит внутри каждой волны ──
                int sub1 = 0
                int sub2 = 0
                int sub3 = 0
                int sub4 = 0
                int sub5 = 0
                if okLocal and array.size(jx) > 3
                    [a1, l1] = f_subCode(jx, jy, jh, array.get(zx, i0), array.get(zx, i0 + 1), okImp, okDia, okTri, tol)
                    [a2, l2] = f_subCode(jx, jy, jh, array.get(zx, i0 + 1), array.get(zx, i0 + 2), okImp, okDia, okTri, tol)
                    sub1 := a1
                    sub2 := a2
                    if legs >= 3
                        [a3, l3] = f_subCode(jx, jy, jh, array.get(zx, i0 + 2), array.get(zx, i0 + 3), okImp, okDia, okTri, tol)
                        sub3 := a3
                    if legs == 5
                        [a4, l4] = f_subCode(jx, jy, jh, array.get(zx, i0 + 3), array.get(zx, i0 + 4), okImp, okDia, okTri, tol)
                        [a5, l5] = f_subCode(jx, jy, jh, array.get(zx, i0 + 4), array.get(zx, i0 + 5), okImp, okDia, okTri, tol)
                        sub4 := a4
                        sub5 := a5

                // ── ДВОЙНОЙ ЗИГЗАГ / КОМБИНАЦИЯ: различие ТОЛЬКО в подструктуре ──
                // Гайд: W и Y двойного зигзага — строго одинарные зигзаги; в комбинации
                // только одна из W и Y может быть зигзагом, а X откатывает ≥ 90% W.
                if legs == 3 and okLocal and sub1 != 0 and sub3 != 0
                    bool wZig = f_isZigzag(sub1)
                    bool yZig = f_isZigzag(sub3)
                    if wZig and yZig and (code == 10 or code == 14)
                        code := 15
                        note += " · W и Y — зигзаги"
                        ewConf := math.min(ewConf + 0.10, 0.95)
                    else if (wZig != yZig) and (code == 14 or f_isFlat(code))
                        code := 14
                        note += " · только одна из W/Y зигзаг"

                bool   lok = true
                string lwhy = ""
                if okLocal
                    [locOk, locWhy] = f_localCheck(code, sub1, sub2, sub3, sub4, sub5)
                    lok := locOk
                    lwhy := locWhy
                if not lok
                    ewConf := math.max(ewConf - 0.20, 0.05)

                // ── ОТРИСОВКА ───────────────────────────────────────────────
                color cc = f_isMotive(code) ? col : color.new(col, 30)
                string st = code == 1 ? line.style_solid : line.style_dashed
                for k = 0 to legs - 1
                    array.push(hist, line.new(array.get(zx, i0 + k), array.get(zy, i0 + k),
                         array.get(zx, i0 + k + 1), array.get(zy, i0 + k + 1),
                         color = cc, style = st, width = lw))
                for k = 1 to legs
                    string lbl = legs == 5 and f_isTriangle(code) ?
                         (k == 1 ? "A" : k == 2 ? "B" : k == 3 ? "C" : k == 4 ? "D" : "E") :
                         legs == 5 ? str.tostring(k) :
                         code == 15 or code == 14 ? (k == 1 ? "W" : k == 2 ? "X" : "Y") :
                         (k == 1 ? "A" : k == 2 ? "B" : "C")
                    array.push(histB, label.new(array.get(zx, i0 + k), array.get(zy, i0 + k), lbl,
                         textcolor = color.white, color = color.new(cc, 15),
                         style = array.get(zh, i0 + k) ? label.style_label_down : label.style_label_up, size = sz))
                array.push(histB, label.new(array.get(zx, i0 + legs), array.get(zy, i0 + legs),
                     f_structName(code) + "  " + str.tostring(ewConf, "#.##") + (lok ? "" : " ⚠"),
                     textcolor = color.white, color = color.new(cc, 35),
                     style = array.get(zh, i0 + legs) ? label.style_label_down : label.style_label_up, size = sz))
                while array.size(hist) > keep * 5
                    line.delete(array.shift(hist))
                while array.size(histB) > keep * 6
                    label.delete(array.shift(histB))

                curCode := code
                curX0 := x0
                curLegs := legs
                curConf := ewConf
                curNote := note
                curDir := array.get(zy, i0 + 1) > array.get(zy, i0) ? 1 : -1
                curEndX := array.get(zx, i0 + legs)
                curInvalid := array.get(zy, i0)
                curLocalOk := lok
                curWhy := lwhy

    // ── 2. ПРОГНОЗ: что должно случиться дальше ────────────────────────────
    // Считается на КАЖДОМ баре по подтверждённым точкам: сначала ищем незавершённую
    // структуру (последние 4-5 точек), для неё считаем цель текущей волны по нормам
    // и канал. Если незавершённой нет — прогноз строится от завершённой структуры.
    if enabled and fcast and barstate.islast and n >= 4
        while array.size(fc) > 0
            line.delete(array.pop(fc))
        while array.size(fcB) > 0
            label.delete(array.pop(fcB))
        fcastTxt := ""
        fcastT1 := na
        fcastT2 := na

        int last = n - 1
        float pL = array.get(zy, last)
        int   xL = array.get(zx, last)

        // — незавершённый импульс: есть 1-2-3-4, идёт волна 5 —
        if n >= 5
            int b = n - 5
            float q0 = array.get(zy, b)
            float q1 = array.get(zy, b + 1)
            float q2 = array.get(zy, b + 2)
            float q3 = array.get(zy, b + 3)
            float q4 = array.get(zy, b + 4)
            bool up = q1 > q0
            float w1 = f_len(q0, q1)
            float w3 = f_len(q2, q3)
            bool r1 = not f_beyond(not up, q2, q0)
            bool r3 = not f_beyond(not up, q4, q1)
            if r1 and r3 and f_beyond(up, q3, q1) and w1 > 0 and w3 > 0
                // цель волны 5: равенство с волной 1 либо 0.618 волны 3 (норма гайда)
                float t1 = up ? q4 + w1 : q4 - w1
                float t2 = up ? q4 + w3 * 0.618 : q4 - w3 * 0.618
                fcastT1 := t1
                fcastT2 := t2
                fcastTxt := "идёт волна 5 → цель " + str.tostring(t1, format.mintick) +
                     " (=w1) или " + str.tostring(t2, format.mintick) + " (0.618·w3)"
                if drawTgt
                    array.push(fc, line.new(xL, t1, bar_index + 30, t1, color = color.new(col, 20), style = line.style_dotted, width = 2))
                    array.push(fc, line.new(xL, t2, bar_index + 30, t2, color = color.new(col, 50), style = line.style_dotted))
                // канал: через концы волн 1 и 3, перенос на конец волны 4 → цель волны 5
                if drawChan
                    float ch = f_channelAt(array.get(zx, b + 1), q1, array.get(zx, b + 3), q3,
                         array.get(zx, b + 4), q4, bar_index + 30)
                    array.push(fc, line.new(array.get(zx, b + 4), q4, bar_index + 30, ch,
                         color = color.new(col, 35), style = line.style_dashed))
                    fcastTxt += " · канал " + str.tostring(ch, format.mintick)

        // — незавершённая коррекция: есть A и B, идёт C —
        if fcastTxt == "" and n >= 3
            int b = n - 3
            float q0 = array.get(zy, b)
            float q1 = array.get(zy, b + 1)
            float q2 = array.get(zy, b + 2)
            bool up = q1 > q0
            float A = f_len(q0, q1)
            float B = f_len(q1, q2)
            float retrB = A > 0 ? B / A : na
            if not na(retrB) and retrB <= 2.0 and A > 0
                bool flat = retrB >= 0.9
                // зигзаг: C = 100% или 162% волны A · плоскость: C = 162% волны A
                float t1 = up ? q2 + A * (flat ? 1.618 : 1.0) : q2 - A * (flat ? 1.618 : 1.0)
                float t2 = up ? q2 + A * (flat ? 1.0 : 1.618) : q2 - A * (flat ? 1.0 : 1.618)
                fcastT1 := t1
                fcastT2 := t2
                fcastTxt := (flat ? "идёт волна C плоскости" : "идёт волна C зигзага") +
                     " → цель " + str.tostring(t1, format.mintick) + " / " + str.tostring(t2, format.mintick)
                if f_near(retrB, 0.382, tol)
                    fcastTxt += " (B≈0.382 → ждём C≈0.618·A)"
                if drawTgt
                    array.push(fc, line.new(xL, t1, bar_index + 30, t1, color = color.new(col, 20), style = line.style_dotted, width = 2))
                    array.push(fc, line.new(xL, t2, bar_index + 30, t2, color = color.new(col, 50), style = line.style_dotted))
                // канал зигзага: через основание A и конец B, перенос на конец A → цель C
                if drawChan
                    float ch = f_channelAt(array.get(zx, b), q0, array.get(zx, b + 2), q2,
                         array.get(zx, b + 1), q1, bar_index + 30)
                    array.push(fc, line.new(array.get(zx, b + 1), q1, bar_index + 30, ch,
                         color = color.new(col, 35), style = line.style_dashed))
                    fcastTxt += " · канал " + str.tostring(ch, format.mintick)

        // — от завершённой структуры: чего ждать по канону —
        if fcastTxt == "" and curCode != 0
            if curCode == 1
                fcastTxt := "импульс завершён → коррекция 0.382-0.618 всего движения"
            else if f_isCorr(curCode)
                fcastTxt := f_structName(curCode) + " завершена → движение в сторону старшего тренда"
            else if f_isTriangle(curCode)
                fcastTxt := "треугольник завершён → выброс (thrust) в сторону тренда"

        if fcastTxt != ""
            array.push(fcB, label.new(bar_index + 30, nz(fcastT1, close), "прогноз",
                 textcolor = color.white, color = color.new(col, 40),
                 style = label.style_label_left, size = sz))

    if drawInv and not na(curInvalid) and barstate.islast
        array.push(fc, line.new(nz(curEndX, bar_index), curInvalid, bar_index + 30, curInvalid,
             color = color.new(color.red, 40), style = line.style_dashed))

    [curCode, curConf, curNote, curDir, curLegs, curInvalid, curLocalOk, curWhy, fcastTxt]

// ─── ТРИ СТЕПЕНИ ────────────────────────────────────────────────────────────
var zx1 = array.new_int()
var zy1 = array.new_float()
var zh1 = array.new_bool()
var zx2 = array.new_int()
var zy2 = array.new_float()
var zh2 = array.new_bool()
var zx3 = array.new_int()
var zy3 = array.new_float()
var zh3 = array.new_bool()

simple int zzLen = math.max(1, int(zzDepth / 2))
ch1 = s1on ? f_zzUpdate(zx1, zy1, zh1, zzLen, dev1, zzAtrLen) : false
ch2 = s2on ? f_zzUpdate(zx2, zy2, zh2, zzLen, dev2, zzAtrLen) : false
ch3 = s3on ? f_zzUpdate(zx3, zy3, zh3, zzLen, dev3, zzAtrLen) : false

// младшая степень для степени 1 — она сама (подструктур ниже нет)
[ewC1, ewCf1, ewNt1, ewD1, ewLg1, ewIv1, lok1, why1, fx1] = f_mark(zx1, zy1, zh1, zx1, zy1, zh1, ch1, s1on, col1, maxStruct, SZ, ewLineW, useImpulse, useDiagonal, useTriangle, useCorr3, false,     normTol, useForecast, showChannel, showTargets, showInvalid)
[ewC2, ewCf2, ewNt2, ewD2, ewLg2, ewIv2, lok2, why2, fx2] = f_mark(zx2, zy2, zh2, zx1, zy1, zh1, ch2, s2on, col2, maxStruct, SZ, ewLineW, useImpulse, useDiagonal, useTriangle, useCorr3, useLocal, normTol, useForecast, showChannel, showTargets, showInvalid)
[ewC3, ewCf3, ewNt3, ewD3, ewLg3, ewIv3, lok3, why3, fx3] = f_mark(zx3, zy3, zh3, zx2, zy2, zh2, ch3, s3on, col3, maxStruct, SZ, ewLineW, useImpulse, useDiagonal, useTriangle, useCorr3, useLocal, normTol, useForecast, showChannel, showTargets, showInvalid)

// ─── ПАНЕЛЬ ─────────────────────────────────────────────────────────────────
f_dirTxt(int d) => d == 1 ? "вверх" : d == -1 ? "вниз" : "—"

var table ewTb = table.new(position.bottom_right, 4, 9, border_width = 1,
     bgcolor = color.new(#131722, 0), frame_color = color.new(color.gray, 40), frame_width = 1)

if showTableEW and barstate.islast
    table.clear(ewTb, 0, 0, 3, 8)
    color hdr = color.new(#2a2e39, 0)
    table.cell(ewTb, 0, 0, "OKO Elliott v3", bgcolor = hdr, text_color = color.white, text_size = SZ)
    table.cell(ewTb, 1, 0, "структура", bgcolor = hdr, text_color = color.white, text_size = SZ)
    table.cell(ewTb, 2, 0, "напр.", bgcolor = hdr, text_color = color.white, text_size = SZ)
    table.cell(ewTb, 3, 0, "нормы · локальные структуры", bgcolor = hdr, text_color = color.white, text_size = SZ)

    table.cell(ewTb, 0, 1, "степень 1 · dev " + str.tostring(dev1), text_size = SZ, text_color = col1)
    table.cell(ewTb, 1, 1, f_structName(ewC1), text_size = SZ, text_color = color.white)
    table.cell(ewTb, 2, 1, f_dirTxt(ewD1), text_size = SZ, text_color = color.white)
    table.cell(ewTb, 3, 1, ewNt1 + " (" + str.tostring(ewCf1, "#.##") + ")", text_size = SZ, text_color = color.white)

    table.cell(ewTb, 0, 2, "степень 2 · dev " + str.tostring(dev2), text_size = SZ, text_color = col2)
    table.cell(ewTb, 1, 2, f_structName(ewC2), text_size = SZ, text_color = color.white)
    table.cell(ewTb, 2, 2, f_dirTxt(ewD2), text_size = SZ, text_color = color.white)
    table.cell(ewTb, 3, 2, ewNt2 + " (" + str.tostring(ewCf2, "#.##") + ")" + (lok2 ? "" : "  ⚠ " + why2),
         text_size = SZ, text_color = color.white, bgcolor = lok2 ? na : color.new(color.red, 65))

    table.cell(ewTb, 0, 3, "степень 3 · dev " + str.tostring(dev3), text_size = SZ, text_color = col3)
    table.cell(ewTb, 1, 3, f_structName(ewC3), text_size = SZ, text_color = color.white)
    table.cell(ewTb, 2, 3, f_dirTxt(ewD3), text_size = SZ, text_color = color.white)
    table.cell(ewTb, 3, 3, ewNt3 + " (" + str.tostring(ewCf3, "#.##") + ")" + (lok3 ? "" : "  ⚠ " + why3),
         text_size = SZ, text_color = color.white, bgcolor = lok3 ? na : color.new(color.red, 65))

    table.cell(ewTb, 0, 4, "ПРОГНОЗ ст.1", bgcolor = hdr, text_color = color.white, text_size = SZ)
    table.cell(ewTb, 1, 4, fx1, text_size = SZ, text_color = color.white)
    table.cell(ewTb, 2, 4, "", text_size = SZ)
    table.cell(ewTb, 3, 4, "", text_size = SZ)
    table.cell(ewTb, 0, 5, "ПРОГНОЗ ст.2", bgcolor = hdr, text_color = color.white, text_size = SZ)
    table.cell(ewTb, 1, 5, fx2, text_size = SZ, text_color = color.white)
    table.cell(ewTb, 2, 5, "", text_size = SZ)
    table.cell(ewTb, 3, 5, "", text_size = SZ)
    table.cell(ewTb, 0, 6, "ПРОГНОЗ ст.3", bgcolor = hdr, text_color = color.white, text_size = SZ)
    table.cell(ewTb, 1, 6, fx3, text_size = SZ, text_color = color.white)
    table.cell(ewTb, 2, 6, "", text_size = SZ)
    table.cell(ewTb, 3, 6, "", text_size = SZ)

    table.cell(ewTb, 0, 7, "инвалидация ст.2", text_size = SZ, text_color = color.gray)
    table.cell(ewTb, 1, 7, na(ewIv2) ? "—" : str.tostring(ewIv2, format.mintick), text_size = SZ, text_color = color.white)
    table.cell(ewTb, 2, 7, "лаг 6 бар.", text_size = SZ, text_color = color.gray)
    table.cell(ewTb, 3, 7, "хвост может переразметиться", text_size = SZ, text_color = color.gray)

// ─── DATA WINDOW ────────────────────────────────────────────────────────────
plot(ewC1,  "struct_deg1", display = display.data_window)
plot(ewC2,  "struct_deg2", display = display.data_window)
plot(ewC3,  "struct_deg3", display = display.data_window)
plot(ewCf1, "conf_deg1",   display = display.data_window)
plot(ewCf2, "conf_deg2",   display = display.data_window)
plot(ewCf3, "conf_deg3",   display = display.data_window)
plot(ewD1,  "dir_deg1",    display = display.data_window)
plot(ewD2,  "dir_deg2",    display = display.data_window)
plot(ewD3,  "dir_deg3",    display = display.data_window)
plot(ewLg1, "legs_deg1",   display = display.data_window)
plot(ewLg2, "legs_deg2",   display = display.data_window)
plot(ewLg3, "legs_deg3",   display = display.data_window)
plot(ewIv2, "invalidation_deg2", display = display.data_window)
plot(lok2 ? 1 : 0, "local_ok_deg2", display = display.data_window)
plot(lok3 ? 1 : 0, "local_ok_deg3", display = display.data_window)

// ─── АЛЕРТЫ ─────────────────────────────────────────────────────────────────
alertcondition(ewC2 != ewC2[1] and ewC2 != 0, "Новая структура · степень 2", "OKO EW3: размечена новая структура")
alertcondition(ewC2 == 1 and ewC2[1] != 1, "Импульс завершён · степень 2", "OKO EW3: импульс 5 волн завершён")
alertcondition(not lok2 and lok2[1], "Нарушение локальных структур", "OKO EW3: подструктура противоречит канону")
