//@version=5
// ═══════════════════════════════════════════════════════════════════════════════════════════════════
// OKO-SM · CHoCH-формация — Егор, 22.09.2026 (ZEC/BCH/GRT 3m)
// Структура — ДОСЛОВНО как OkoSM_v163 / core.smc.oko_sm_engine.run_structure (детектор бота):
//   swings(len): os := high[len] > ta.highest(len) ? 0 : low[len] < ta.lowest(len) ? 1 : os[1]
//   внутренний слом — crossover/crossunder close через itop_y/ibtm_y при itop_cross/ibtm_cross и itop_y ≠ top_y,
//   CHoCH = слом против текущего itrend, BOS = слом по тренду. Фильтр «конфлюэнции» LuxAlgo НЕ используется.
//
// ДВА РЕЖИМА ФОРМАЦИИ (22.09, Егор: «почему на падении зелёные, а на взлёте в продажу?»):
//   РАЗВОРОТ    — значимый экстремум окна (максимум/минимум sigLook баров) → первый слом ПРОТИВ хода.
//                 На тренде экстремум обновляется каждым шагом, поэтому формации идут ПРОТИВ движения.
//   ПРОДОЛЖЕНИЕ — вершина/дно ОТКАТА (последний внутренний свинг) → слом ПО тренду (BOS). Формации идут ПО движению.
//
// ВОЛНОВОЙ КОНТЕКСТ: слой 1 (ctxTf) — зрелость импульса по счёту сломов подряд; слой 2 (strTf) — направление ноги.
//   Разворот разрешён, когда слой 1 зрелый и слой 2 уже развернулся; продолжение — когда оба слоя смотрят в одну сторону.
// ВОЛНА A (опция): после формации первый встречный CHoCH = A закончена; зона отката 0.5–0.705 A, стоп 0.886.
// WT-фильтр (канон бота/OkoTrend: 10/21, ±60, допуск 10) — только для РАЗВОРОТА: откат по тренду до OB/OS не доходит.
// Внимание: замер 22.09 (3893 сетапа 2020-26) — вход в зону отката A сам по себе ≈ 0; это инструмент разметки.
// ═══════════════════════════════════════════════════════════════════════════════════════════════════
indicator("OKO-SM · CHoCH-формация", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 2000)

// ── настройки (22.09, Егор: «давай настройки упрощать») — всё редкое ушло в константы ниже
sides      = input.string("обе", "Стороны", options = ["обе", "только шорт", "только лонг"])
mode       = input.string("разворот", "Формация", options = ["разворот", "продолжение", "оба"])
swingLen   = input.int(50, "Swing length (старший слой)", minval = 10)
intLen     = input.int(5,  "Internal length (младший слой)", minval = 2)
showA      = input.bool(true, "Волна A и зона отката 0.5–0.705 / стоп 0.886")
sigLook    = input.int(150, "Значимость: экстремум N баров (0 = выкл)", minval = 0, group = "Фильтры")
minAtrK    = input.float(1.5, "Высота формации ≥ k·ATR(14)", minval = 0, step = 0.5, group = "Фильтры")
legAtrK    = input.float(3.0, "Ход в окне ≥ k·ATR(14) (0 = выкл)", minval = 0, step = 0.5, group = "Фильтры")
maxWait    = input.int(60, "Ждать слом после экстремума, баров", minval = 3, group = "Фильтры")
onlyChoch  = input.bool(false, "Разворот только по CHoCH (иначе любой слом)", group = "Фильтры")
useWt      = input.bool(true, "Разворот только у OB/OS WaveTrend", group = "Фильтры")
wtTf       = input.timeframe("60", "ТФ WaveTrend (пусто = ТФ графика)", group = "Фильтры")
colorBars  = input.bool(true, "Красить бары по WT", group = "Бары")
barWtTf    = input.timeframe("", "ТФ WT для баров (пусто = ТФ графика)", group = "Бары")
useWave    = input.bool(true, "Волновой контекст (фильтр формаций)", group = "Волны")
ctxTf      = input.timeframe("240", "Слой 1 — КОНТЕКСТ (зрелость импульса)", group = "Волны")
strTf      = input.timeframe("60",  "Слой 2 — СТРУКТУРА (направление ноги)", group = "Волны")
minLegs    = input.int(3, "Зрелость: сломов подряд в одну сторону ≥", minval = 1, group = "Волны")
showWaves  = input.bool(true, "Рисовать ноги слоёв и табло", group = "Волны")

// ── константы: канон WT (как в core/intelligence/wt_service.py и OkoTrend) и геометрия рисовки
int   WT_N1 = 10
int   WT_N2 = 21
float WT_OB = 60.0
float WT_OS = -60.0
float WT_TOL = 10.0
int   MAXLOOK = 600
int   PRE = 30
color C_BEAR = color.new(color.red, 85)
color C_BULL = color.new(color.green, 85)
color C_ZONE = color.new(color.orange, 80)
color C_CTX  = color.orange
color C_STR  = color.new(color.gray, 30)
// раскраска баров: кросс WT × сторона медианы (медиана WT = нулевая линия осциллятора)
color C_UP_HI  = #66BB6A      // wt1 > wt2 и НАД медианой — светло-зелёный
color C_UP_LO  = #1B5E20      // wt1 > wt2, но под медианой — тёмно-зелёный
color C_DN_HI  = #C62828      // wt1 < wt2, ещё над медианой — красный
color C_DN_LO  = #FF1744      // wt1 < wt2 и ПОД медианой — ярко-красный

showBear = sides != "только лонг"
showBull = sides != "только шорт"

n = bar_index
atr14 = ta.atr(14)
hiN = ta.highest(high, math.max(sigLook, 1))     // экстремум окна значимости (считаем на каждом баре, не в ветке)
loN = ta.lowest(low,  math.max(sigLook, 1))
// ход в окне: отсекает «ступеньки» пологого сползания, где экстремум обновляется, а движения нет
runOk = legAtrK == 0 or (hiN - loN) >= legAtrK * atr14

// последний внутренний свинг из истории, стоящий ДО бара x (иначе na)
lastBefore(arr, x) =>
    int res = na
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            v = array.get(arr, i)
            if v < x
                res := v
                break
    res

wtCalc() =>
    hlc3_ = (high + low + close) / 3
    esa = ta.ema(hlc3_, WT_N1)
    dd  = ta.ema(math.abs(hlc3_ - esa), WT_N1)
    ta.ema((hlc3_ - esa) / (0.015 * dd), WT_N2)
// WT со старшего ТФ — по ЗАКРЫТОМУ бару (без перерисовки): [1] + lookahead_on — стандартный приём
wtLoc = wtCalc()
wtHtf = request.security(syminfo.tickerid, wtTf, wtCalc()[1], lookahead = barmerge.lookahead_on)
wt1 = wtTf == "" ? wtLoc : wtHtf

// ── раскраска баров (Егор 22.09): wt1 > wt2 — зелёные, над медианой — светлее; кросс вниз — красные,
// под медианой — ярче. wt2 = SMA(wt1, 4) как в каноне WaveTrend, медиана = нулевая линия осциллятора.
wtSig() =>
    w = wtCalc()
    ta.sma(w, 4)
wtLoc2 = wtSig()
wtHtf1 = request.security(syminfo.tickerid, barWtTf, wtCalc()[1], lookahead = barmerge.lookahead_on)
wtHtf2 = request.security(syminfo.tickerid, barWtTf, wtSig()[1],  lookahead = barmerge.lookahead_on)
bw1 = barWtTf == "" ? wtLoc  : wtHtf1
bw2 = barWtTf == "" ? wtLoc2 : wtHtf2
bool wtUp = bw1 > bw2
bool wtAbove = bw1 > 0
barcolor(colorBars ? (wtUp ? (wtAbove ? C_UP_HI : C_UP_LO) : (wtAbove ? C_DN_HI : C_DN_LO)) : na)

// линия слома как в OKO-SM display_Structure: от бара свинга до бара слома, подпись по центру
chochLine(x1, y, col, up) =>
    if not na(x1) and not na(y)
        line.new(x1, y, n, y, color = col, width = 2)
        label.new(int(math.round((x1 + n) / 2)), y, "CHoCH", style = up ? label.style_label_down : label.style_label_up,
                  color = color.new(col, 100), textcolor = col, size = size.small)

swings(len) =>
    var os = 0
    upper = ta.highest(len)
    lower = ta.lowest(len)
    os := high[len] > upper ? 0 : low[len] < lower ? 1 : os[1]
    top = os == 0 and os[1] != 0 ? high[len] : 0.
    btm = os == 1 and os[1] != 1 ? low[len] : 0.
    [top, btm]

// ── СЛОЙ ВОЛН: та же структура OKO-SM на старшем ТФ + СЧЁТ сломов подряд в одну сторону.
// Счёт — механизируемый заменитель счёта волн: 1-2 слома = ход только начался, ≥ minLegs = импульс зрелый.
// ВАЖНО (баг 22.09): сдвиг на закрытый бар делается ВНУТРИ функции — история элементов РАСПАКОВАННОГО
// кортежа не держится, обёртка возвращала na и фильтр молча глушил каждую формацию.
legScan(swLen, ilLen) =>
    var float tY = na, var float bY = na, var float itY = na, var float ibY = na
    var bool itC = true, var bool ibC = true
    var int tr = 0, var int cnt = 0
    var float pTop = na, var int tTop = na, var float pBtm = na, var int tBtm = na
    var float lastTopWt = na, var float lastBtmWt = na
    var bool divUp = false, var bool divDn = false
    w = wtCalc()
    [tp, bm]   = swings(swLen)
    [itp, ibm] = swings(ilLen)
    if tp > 0
        tY := tp
    if bm > 0
        bY := bm
    if itp > 0
        itC := true
        itY := itp
        divUp := not na(pTop) and itp > pTop and w[ilLen] < lastTopWt     // новый максимум при ослабшем WT = слабая пятая
        pTop := itp
        tTop := time[ilLen]
        lastTopWt := w[ilLen]
    if ibm > 0
        ibC := true
        ibY := ibm
        divDn := not na(pBtm) and ibm < pBtm and w[ilLen] > lastBtmWt
        pBtm := ibm
        tBtm := time[ilLen]
        lastBtmWt := w[ilLen]
    if not na(itY) and ta.crossover(close, itY) and itC and tY != itY
        cnt := tr == 1 ? cnt + 1 : 1
        tr := 1
        itC := false
    if not na(ibY) and ta.crossunder(close, ibY) and ibC and bY != ibY
        cnt := tr == -1 ? cnt + 1 : 1
        tr := -1
        ibC := false
    int dU = divUp ? 1 : 0
    int dD = divDn ? 1 : 0
    [tr[1], cnt[1], dU[1], dD[1], pTop[1], tTop[1], pBtm[1], tBtm[1]]

// ── зигзаг ноги слоя по ВРЕМЕНИ бара (xloc.bar_time).
// Флаг видимости — параметром: функция с var обязана вызываться на КАЖДОМ баре, иначе её состояние рвётся.
zig(pTop, tTop, pBtm, tBtm, col, wdt, cnt, showNum, on) =>
    var float zPx = na, var int zT = na
    if not na(tTop) and tTop != nz(tTop[1], 0)
        if on and not na(zT) and zT < tTop
            line.new(zT, zPx, tTop, pTop, xloc = xloc.bar_time, color = col, width = wdt)
            if showNum
                label.new(tTop, pTop, str.tostring(cnt, "#"), xloc = xloc.bar_time, style = label.style_label_down,
                          color = color.new(col, 100), textcolor = col, size = size.tiny)
        zPx := pTop
        zT := tTop
    if not na(tBtm) and tBtm != nz(tBtm[1], 0)
        if on and not na(zT) and zT < tBtm
            line.new(zT, zPx, tBtm, pBtm, xloc = xloc.bar_time, color = col, width = wdt)
            if showNum
                label.new(tBtm, pBtm, str.tostring(cnt, "#"), xloc = xloc.bar_time, style = label.style_label_up,
                          color = color.new(col, 100), textcolor = col, size = size.tiny)
        zPx := pBtm
        zT := tBtm

[ctxDir, ctxCnt, ctxDivU, ctxDivD, ctxPTop, ctxTTop, ctxPBtm, ctxTBtm] = request.security(syminfo.tickerid, ctxTf, legScan(swingLen, intLen), lookahead = barmerge.lookahead_on)
[strDir, strCnt, strDivU, strDivD, strPTop, strTTop, strPBtm, strTBtm] = request.security(syminfo.tickerid, strTf, legScan(swingLen, intLen), lookahead = barmerge.lookahead_on)

zig(ctxPTop, int(ctxTTop), ctxPBtm, int(ctxTBtm), C_CTX, 2, int(ctxCnt), true,  showWaves)
zig(strPTop, int(strTTop), strPBtm, int(strTBtm), C_STR, 1, int(strCnt), false, showWaves)

// РАЗВОРОТ: слой 1 выработал ход, слой 2 уже развернулся против него.
// ПРОДОЛЖЕНИЕ: оба слоя смотрят в одну сторону — входим по тренду после отката.
bearRevWave  = not useWave or (ctxDir ==  1 and ctxCnt >= minLegs and strDir == -1)
bullRevWave  = not useWave or (ctxDir == -1 and ctxCnt >= minLegs and strDir ==  1)
bearContWave = not useWave or (ctxDir == -1 and strDir == -1)
bullContWave = not useWave or (ctxDir ==  1 and strDir ==  1)

[top, btm]   = swings(swingLen)
[itop, ibtm] = swings(intLen)

var float top_y  = na
var float btm_y  = na
var float itop_y = na
var float ibtm_y = na
var int   itop_x = na
var int   ibtm_x = na
var int[] itopHist = array.new_int()      // бары внутренних свингов — для левого края формации
var int[] ibtmHist = array.new_int()
var bool  itop_cross = true
var bool  ibtm_cross = true
var int   itrend = 0

if top > 0
    top_y := top
if btm > 0
    btm_y := btm
if itop > 0
    itop_cross := true
    itop_y := itop
    itop_x := n - intLen
    array.push(itopHist, itop_x)
    if array.size(itopHist) > 500
        array.shift(itopHist)
if ibtm > 0
    ibtm_cross := true
    ibtm_y := ibtm
    ibtm_x := n - intLen
    array.push(ibtmHist, ibtm_x)
    if array.size(ibtmHist) > 500
        array.shift(ibtmHist)

bool bullBreak = false, bool bearBreak = false, bool bullChoch = false, bool bearChoch = false
float chLvlUp = na, int chXUp = na, float chLvlDn = na, int chXDn = na      // уровень и бар сломанного свинга
if not na(itop_y) and ta.crossover(close, itop_y) and itop_cross and top_y != itop_y
    bullBreak := true
    bullChoch := itrend < 0
    chLvlUp := itop_y
    chXUp := itop_x
    itop_cross := false
    itrend := 1
if not na(ibtm_y) and ta.crossunder(close, ibtm_y) and ibtm_cross and btm_y != ibtm_y
    bearBreak := true
    bearChoch := itrend > 0
    chLvlDn := ibtm_y
    chXDn := ibtm_x
    ibtm_cross := false
    itrend := -1

// ── состояние ожидания волны A
var float sTop = na, var int sTopBar = na, var bool sArmed = false
var float lBot = na, var int lBotBar = na, var bool lArmed = false
var box   sZone = na, var line sStop = na, var float sStopPx = na
var box   lZone = na, var line lStop = na, var float lStopPx = na

// ── продление живых зон отката
if not na(sZone)
    if high >= sStopPx
        sZone := na
        sStop := na
    else
        box.set_right(sZone, n)
        line.set_x2(sStop, n)
if not na(lZone)
    if low <= lStopPx
        lZone := na
        lStop := na
    else
        box.set_right(lZone, n)
        line.set_x2(lStop, n)

// ── значимый экстремум окна (источник вершины для РАЗВОРОТА)
var float sigHi = na, var int sigHiBar = na, var bool sigHiUsed = true
var float sigLo = na, var int sigLoBar = na, var bool sigLoUsed = true
if sigLook == 0 or high >= hiN
    sigHi := high
    sigHiBar := n
    sigHiUsed := false
if sigLook == 0 or low <= loN
    sigLo := low
    sigLoBar := n
    sigLoUsed := false

// ══ МЕДВЕЖЬЯ ФОРМАЦИЯ
bool revBear  = (onlyChoch ? bearChoch : bearBreak) and not sigHiUsed and not na(sigHiBar) and n - sigHiBar <= maxWait and n > sigHiBar
bool contBear = bearBreak and not bearChoch and not na(itop_x) and n > itop_x and n - itop_x <= maxWait
bool doRevBear  = revBear and mode != "продолжение" and bearRevWave
bool doContBear = contBear and mode != "разворот" and not doRevBear and bearContWave
if (doRevBear or doContBear) and showBear and runOk
    float topPx  = doRevBear ? sigHi : itop_y
    int   topBar = doRevBear ? sigHiBar : itop_x
    sw = lastBefore(ibtmHist, topBar)
    int x1 = na(sw) ? math.max(topBar - PRE, n - MAXLOOK) : math.max(sw, n - MAXLOOK)
    int len = math.min(n - x1, MAXLOOK)
    float hi = topPx, float lo = low, float wtMax = -999
    for k = 0 to len
        lo := math.min(lo, low[k])
        hi := math.max(hi, high[k])
        wtMax := math.max(wtMax, nz(wt1[k], -999))
    // WT требуем только у разворота: откат по тренду до OB старшего ТФ обычно не доходит
    if (hi - lo) >= minAtrK * atr14 and (not useWt or not doRevBear or wtMax >= WT_OB - WT_TOL)
        box.new(x1, hi, n, lo, border_color = color.new(color.red, 20), bgcolor = C_BEAR, border_width = 2)
        label.new(topBar, hi, doRevBear ? "5" : "→", style = label.style_label_down,
                  color = color.new(color.red, 100), textcolor = color.red, size = size.small)
        chochLine(chXDn, chLvlDn, color.red, false)
        sTop := hi, sTopBar := topBar, sArmed := true
        lArmed := false
        if doRevBear
            sigHiUsed := true

// ══ БЫЧЬЯ ФОРМАЦИЯ
bool revBull  = (onlyChoch ? bullChoch : bullBreak) and not sigLoUsed and not na(sigLoBar) and n - sigLoBar <= maxWait and n > sigLoBar
bool contBull = bullBreak and not bullChoch and not na(ibtm_x) and n > ibtm_x and n - ibtm_x <= maxWait
bool doRevBull  = revBull and mode != "продолжение" and bullRevWave
bool doContBull = contBull and mode != "разворот" and not doRevBull and bullContWave
if (doRevBull or doContBull) and showBull and runOk
    float botPx  = doRevBull ? sigLo : ibtm_y
    int   botBar = doRevBull ? sigLoBar : ibtm_x
    sw = lastBefore(itopHist, botBar)
    int x1 = na(sw) ? math.max(botBar - PRE, n - MAXLOOK) : math.max(sw, n - MAXLOOK)
    int len = math.min(n - x1, MAXLOOK)
    float lo = botPx, float hi = high, float wtMin = 999
    for k = 0 to len
        hi := math.max(hi, high[k])
        lo := math.min(lo, low[k])
        wtMin := math.min(wtMin, nz(wt1[k], 999))
    if (hi - lo) >= minAtrK * atr14 and (not useWt or not doRevBull or wtMin <= WT_OS + WT_TOL)
        box.new(x1, hi, n, lo, border_color = color.new(color.green, 20), bgcolor = C_BULL, border_width = 2)
        label.new(botBar, lo, doRevBull ? "5" : "→", style = label.style_label_up,
                  color = color.new(color.green, 100), textcolor = color.green, size = size.small)
        chochLine(chXUp, chLvlUp, color.green, true)
        lBot := lo, lBotBar := botBar, lArmed := true
        sArmed := false
        if doRevBull
            sigLoUsed := true

// ── обновление экстремума до окончания A — формация отменяется
if sArmed and high > sTop
    sArmed := false
if lArmed and low < lBot
    lArmed := false

// ── волна A закончена: встречный CHoCH
if showA and sArmed and bullChoch and not bearChoch
    len = math.min(n - sTopBar, MAXLOOK)
    a = low, int aOff = 0
    for k = 0 to len
        if low[k] < a
            a := low[k]
            aOff := k
    A = sTop - a
    if A > 0
        z05 = a + 0.5 * A, z705 = a + 0.705 * A
        sStopPx := a + 0.886 * A
        sZone := box.new(n - aOff, z705, n, z05, border_color = color.new(color.orange, 40), bgcolor = C_ZONE)
        sStop := line.new(n - aOff, sStopPx, n, sStopPx, color = color.red, style = line.style_dashed)
        label.new(n - aOff, a, "A", style = label.style_label_up, color = color.new(color.blue, 100), textcolor = color.blue, size = size.small)
    sArmed := false
if showA and lArmed and bearChoch and not bullChoch
    len = math.min(n - lBotBar, MAXLOOK)
    a = high, int aOff = 0
    for k = 0 to len
        if high[k] > a
            a := high[k]
            aOff := k
    A = a - lBot
    if A > 0
        z05 = a - 0.5 * A, z705 = a - 0.705 * A
        lStopPx := a - 0.886 * A
        lZone := box.new(n - aOff, z05, n, z705, border_color = color.new(color.orange, 40), bgcolor = C_ZONE)
        lStop := line.new(n - aOff, lStopPx, n, lStopPx, color = color.green, style = line.style_dashed)
        label.new(n - aOff, a, "A", style = label.style_label_down, color = color.new(color.blue, 100), textcolor = color.blue, size = size.small)
    lArmed := false

// ── табло: видно, ПОЧЕМУ формаций нет
var table tbl = table.new(position.top_right, 2, 4, border_width = 1, frame_width = 1)
dirTxt(d) => d == 1 ? "вверх" : d == -1 ? "вниз" : "—"
okTxt(b) => b ? "разрешены" : "ждём"
if showWaves and barstate.islast
    table.cell(tbl, 0, 0, "слой 1 · " + ctxTf, text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 0, dirTxt(ctxDir) + " x" + str.tostring(ctxCnt, "#") + (ctxDir == 1 and ctxDivU == 1 or ctxDir == -1 and ctxDivD == 1 ? " див" : ""),
               text_color = ctxCnt >= minLegs ? color.orange : color.gray, text_size = size.small)
    table.cell(tbl, 0, 1, "слой 2 · " + strTf, text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, dirTxt(strDir) + " x" + str.tostring(strCnt, "#"), text_color = color.gray, text_size = size.small)
    bearOk = mode == "продолжение" ? bearContWave : mode == "разворот" ? bearRevWave : bearRevWave or bearContWave
    bullOk = mode == "продолжение" ? bullContWave : mode == "разворот" ? bullRevWave : bullRevWave or bullContWave
    table.cell(tbl, 0, 2, "шорт · " + mode, text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 2, okTxt(bearOk and showBear), text_color = bearOk and showBear ? color.red : color.gray, text_size = size.small)
    table.cell(tbl, 0, 3, "лонг · " + mode, text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 3, okTxt(bullOk and showBull), text_color = bullOk and showBull ? color.green : color.gray, text_size = size.small)

alertcondition(bearChoch, "CHoCH вниз (медвежья формация)", "OKO-SM: внутренний CHoCH вниз")
alertcondition(bullChoch, "CHoCH вверх (бычья формация)",   "OKO-SM: внутренний CHoCH вверх")
