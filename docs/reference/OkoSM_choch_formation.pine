//@version=5
// ═══════════════════════════════════════════════════════════════════════════════════════════════════
// OKO-SM · CHoCH-формация (вершина/дно + слом внутренней структуры) — Егор 22.09.2026, NEAR 3m
// Структура — ДОСЛОВНО как OkoSM_v163 / core.smc.oko_sm_engine.run_structure (детектор бота):
//   swings(len): os := high[len] > ta.highest(len) ? 0 : low[len] < ta.lowest(len) ? 1 : os[1]
//   внутренний слом — crossover/crossunder close через itop_y/ibtm_y при itop_cross/ibtm_cross и itop_y ≠ top_y (swing),
//   CHoCH = слом против текущего itrend. Фильтр «конфлюэнции» LuxAlgo НЕ используется (как в боте).
// ФОРМАЦИЯ (медвежья): от последнего внутреннего слома ВВЕРХ до внутреннего CHoCH ВНИЗ — прямоугольник:
//   левый край — внутренний свинг перед вершиной (по умолчанию) / последний слом / N баров; верх = максимум участка
//   (вершина, «5»), низ = минимум участка, правый край = бар CHoCH.
// ВОЛНА A (опция, как в разборе аналитика): после формации первый встречный внутренний CHoCH ВВЕРХ = A закончена;
//   A = от вершины до минимума между ними; зона отката 0.5–0.705 A и стоп 0.886 — тянутся вправо, пока не пробит стоп
//   или не обновлена вершина. Бычья формация — зеркально.
// ЗНАЧИМОСТЬ: вершина/дно формации = экстремум последних N баров (деф. 150) и высота ≥ k·ATR(14) (деф. 1.5);
//   опция — совпадение со старшим свингом len 50.
// WT-ФИЛЬТР (ТФ WT выбирается, по умолчанию 1h, закрытый бар): медвежья формация остаётся, если на её участке WT1 ≥ OB − допуск; бычья — WT1 ≤ OS + допуск.
// Внимание: замер 22.09 (3893 сетапа 2020-26) — вход в зону отката A сам по себе ≈ 0; это инструмент разметки.
// ═══════════════════════════════════════════════════════════════════════════════════════════════════
indicator("OKO-SM · CHoCH-формация", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 2000)

swingLen   = input.int(50, "Swing length (старший слой)", minval = 10)
intLen     = input.int(5,  "Internal length (младший слой)", minval = 2)
showBear   = input.bool(true,  "Медвежьи формации (вершина → CHoCH вниз)")
showBull   = input.bool(true,  "Бычьи формации (дно → CHoCH вверх)")
minHeight  = input.float(0.3, "Мин. высота формации, %", minval = 0.0, step = 0.1)
maxLook    = input.int(600, "Макс. длина формации, баров", minval = 20, maxval = 1900)
// 22.09 (Егор: «почему такой большой кусок?»): в сильном импульсе внутренние сломы подавлены правилом itop_y ≠ top_y,
// и «последний слом» уезжает на десятки баров назад. По умолчанию левый край = внутренний свинг ПЕРЕД вершиной.
startMode  = input.string("свинг перед вершиной", "Левый край формации", options = ["свинг перед вершиной", "последний слом", "N баров до вершины"])
preBars    = input.int(30, "N баров до вершины (для третьего режима)", minval = 3)
showA      = input.bool(true, "Волна A и зона отката 0.5–0.705 / стоп 0.886")
bearCol    = input.color(color.new(color.red, 85),   "Цвет медвежьей формации")
bullCol    = input.color(color.new(color.green, 85), "Цвет бычьей формации")
zoneCol    = input.color(color.new(color.orange, 80), "Цвет зоны отката")
showAllCh  = input.bool(false, "Линии всех внутренних CHoCH (не только формаций)")
// 22.09 (Егор: «только на значимых экстремумах»): вершина формации обязана быть максимумом последних N баров
// (масштаб значимости) и/или высота формации — не меньше k·ATR. Микрошум 3m отсекается именно этим.
sigLook    = input.int(150, "Значимость: вершина = экстремум N баров (0 = выкл)", minval = 0, group = "Значимость")
minAtrK    = input.float(1.5, "Мин. высота формации в ATR(14) (0 = выкл)", minval = 0, step = 0.5, group = "Значимость")
needSwing  = input.bool(false, "Требовать совпадение со старшим свингом (len 50)", group = "Значимость")
maxWait    = input.int(60, "Ждать слом после экстремума, баров", minval = 3, group = "Значимость")
onlyChoch  = input.bool(false, "Только CHoCH (иначе первый слом: CHoCH или BOS)", group = "Значимость")
swTol      = input.float(0.3, "Допуск совпадения со свингом, %", minval = 0, step = 0.1, group = "Значимость")
// 22.09 фильтр WT (Егор: «оставь только формации, близкие к OB/OS по WTTrend») — WT как в OkoTrend/боте: 10/21/4, ±60
useWt      = input.bool(true, "Только у OB/OS WaveTrend", group = "WT-фильтр")
wtTf       = input.timeframe("60", "ТФ WaveTrend (пусто = ТФ графика)", group = "WT-фильтр")
wtN1       = input.int(10, "WT channel (n1)", group = "WT-фильтр")
wtN2       = input.int(21, "WT average (n2)", group = "WT-фильтр")
wtOB       = input.float(60, "OB", group = "WT-фильтр")
wtOS       = input.float(-60, "OS", group = "WT-фильтр")
wtTol      = input.float(10, "Допуск к уровню (близко = OB − допуск)", minval = 0, group = "WT-фильтр")

n = bar_index
atr14 = ta.atr(14)
hiN = ta.highest(high, math.max(sigLook, 1))     // экстремум окна значимости (считаем на каждом баре, не в ветке)
loN = ta.lowest(low,  math.max(sigLook, 1))
// последний внутренний свинг из истории, стоящий ДО бара x (иначе na)
lastBefore(arr, x) =>
    int res = na
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            v = array.get(arr, i)
            if v < x
                res := v
                break
    res

wtCalc() =>
    hlc3_ = (high + low + close) / 3
    esa = ta.ema(hlc3_, wtN1)
    dd  = ta.ema(math.abs(hlc3_ - esa), wtN1)
    ta.ema((hlc3_ - esa) / (0.015 * dd), wtN2)
// WT со старшего ТФ — по ЗАКРЫТОМУ бару (без перерисовки): [1] + lookahead_on — стандартный приём
wtLoc = wtCalc()
wtHtf = request.security(syminfo.tickerid, wtTf, wtCalc()[1], lookahead = barmerge.lookahead_on)
wt1 = wtTf == "" ? wtLoc : wtHtf

// линия слома как в OKO-SM display_Structure: от бара свинга до бара слома, подпись по центру
chochLine(x1, y, col, up) =>
    if not na(x1) and not na(y)
        line.new(x1, y, n, y, color = col, width = 2)
        label.new(int(math.round((x1 + n) / 2)), y, "CHoCH", style = up ? label.style_label_down : label.style_label_up,
                  color = color.new(col, 100), textcolor = col, size = size.small)

swings(len) =>
    var os = 0
    upper = ta.highest(len)
    lower = ta.lowest(len)
    os := high[len] > upper ? 0 : low[len] < lower ? 1 : os[1]
    top = os == 0 and os[1] != 0 ? high[len] : 0.
    btm = os == 1 and os[1] != 1 ? low[len] : 0.
    [top, btm]

[top, btm]   = swings(swingLen)
[itop, ibtm] = swings(intLen)

var float top_y  = na
var float btm_y  = na
var float itop_y = na
var float ibtm_y = na
var int   itop_x = na
var int   ibtm_x = na
var int[] itopHist = array.new_int()      // бары внутренних свингов — для левого края формации
var int[] ibtmHist = array.new_int()
var bool  itop_cross = true
var bool  ibtm_cross = true
var int   itrend = 0

if top > 0
    top_y := top
if btm > 0
    btm_y := btm
if itop > 0
    itop_cross := true
    itop_y := itop
    itop_x := n - intLen
    array.push(itopHist, itop_x)
    if array.size(itopHist) > 500
        array.shift(itopHist)
if ibtm > 0
    ibtm_cross := true
    ibtm_y := ibtm
    ibtm_x := n - intLen
    array.push(ibtmHist, ibtm_x)
    if array.size(ibtmHist) > 500
        array.shift(ibtmHist)

bool bullBreak = false, bool bearBreak = false, bool bullChoch = false, bool bearChoch = false
float chLvlUp = na, int chXUp = na, float chLvlDn = na, int chXDn = na      // уровень и бар сломанного свинга
if not na(itop_y) and ta.crossover(close, itop_y) and itop_cross and top_y != itop_y
    bullBreak := true
    bullChoch := itrend < 0
    chLvlUp := itop_y
    chXUp := itop_x
    itop_cross := false
    itrend := 1
if not na(ibtm_y) and ta.crossunder(close, ibtm_y) and ibtm_cross and btm_y != ibtm_y
    bearBreak := true
    bearChoch := itrend > 0
    chLvlDn := ibtm_y
    chXDn := ibtm_x
    ibtm_cross := false
    itrend := -1

// ── последний слом в каждую сторону (начало участка формации)
var int lastBullBreak = na
var int lastBearBreak = na

// ── состояние ожидания волны A
var float sTop = na, var int sTopBar = na, var bool sArmed = false          // медвежья: ждём встречный CHoCH вверх
var float lBot = na, var int lBotBar = na, var bool lArmed = false          // бычья: ждём встречный CHoCH вниз
var box   sZone = na, var line sStop = na, var float sStopPx = na
var box   lZone = na, var line lStop = na, var float lStopPx = na

// ── продление живых зон отката
if not na(sZone)
    if high >= sStopPx
        sZone := na
        sStop := na
    else
        box.set_right(sZone, n)
        line.set_x2(sStop, n)
if not na(lZone)
    if low <= lStopPx
        lZone := na
        lStop := na
    else
        box.set_right(lZone, n)
        line.set_x2(lStop, n)

// ══ ФОРМАЦИЯ ОТ ЗНАЧИМОГО ЭКСТРЕМУМА (22.09, Егор: «указанные части не видны»)
// Было: «от слома до слома» — значимая вершина пропадала, если слом пришёл позже окна или оказался BOS, а не CHoCH.
// Стало: сначала фиксируем ЗНАЧИМЫЙ экстремум (максимум последних sigLook баров), потом ждём ПЕРВЫЙ внутренний слом
// против хода (CHoCH или BOS — на выбор) не позже maxWait баров. Левый край — внутренний свинг перед экстремумом.
var float sigHi = na, var int sigHiBar = na, var bool sigHiUsed = true
var float sigLo = na, var int sigLoBar = na, var bool sigLoUsed = true
if sigLook == 0 or high >= hiN
    sigHi := high
    sigHiBar := n
    sigHiUsed := false
if sigLook == 0 or low <= loN
    sigLo := low
    sigLoBar := n
    sigLoUsed := false

bool bearTrig = onlyChoch ? bearChoch : bearBreak
bool bullTrig = onlyChoch ? bullChoch : bullBreak

// ── медвежья формация: значимая вершина → первый слом вниз
if bearTrig and showBear and not sigHiUsed and not na(sigHiBar) and n - sigHiBar <= maxWait and n > sigHiBar
    int x1 = math.max(sigHiBar - preBars, n - maxLook)
    if startMode == "свинг перед вершиной"
        sw = lastBefore(ibtmHist, sigHiBar)
        x1 := na(sw) ? x1 : math.max(sw, n - maxLook)
    else if startMode == "последний слом" and not na(lastBullBreak)
        x1 := math.max(math.min(lastBullBreak, sigHiBar), n - maxLook)
    int len = math.min(n - x1, maxLook)
    float hi = sigHi, float lo = low, float wtMax = -999
    for k = 0 to len
        lo := math.min(lo, low[k])
        hi := math.max(hi, high[k])
        wtMax := math.max(wtMax, nz(wt1[k], -999))
    bool sigOk = (minAtrK == 0 or (hi - lo) >= minAtrK * atr14) and (hi - lo) / lo * 100 >= minHeight
    if needSwing
        sigOk := sigOk and not na(top_y) and math.abs(hi - top_y) / hi * 100 <= swTol
    if sigOk and (not useWt or wtMax >= wtOB - wtTol)
        box.new(x1, hi, n, lo, border_color = color.new(color.red, 20), bgcolor = bearCol, border_width = 2)
        label.new(sigHiBar, hi, "5", style = label.style_label_down, color = color.new(color.red, 100), textcolor = color.red, size = size.small)
        chochLine(chXDn, chLvlDn, color.red, false)
        sTop := hi, sTopBar := sigHiBar, sArmed := true
        lArmed := false
        sigHiUsed := true

// ── бычья формация: значимое дно → первый слом вверх
if bullTrig and showBull and not sigLoUsed and not na(sigLoBar) and n - sigLoBar <= maxWait and n > sigLoBar
    int x1 = math.max(sigLoBar - preBars, n - maxLook)
    if startMode == "свинг перед вершиной"
        sw = lastBefore(itopHist, sigLoBar)
        x1 := na(sw) ? x1 : math.max(sw, n - maxLook)
    else if startMode == "последний слом" and not na(lastBearBreak)
        x1 := math.max(math.min(lastBearBreak, sigLoBar), n - maxLook)
    int len = math.min(n - x1, maxLook)
    float lo = sigLo, float hi = high, float wtMin = 999
    for k = 0 to len
        hi := math.max(hi, high[k])
        lo := math.min(lo, low[k])
        wtMin := math.min(wtMin, nz(wt1[k], 999))
    bool sigOk = (minAtrK == 0 or (hi - lo) >= minAtrK * atr14) and (hi - lo) / lo * 100 >= minHeight
    if needSwing
        sigOk := sigOk and not na(btm_y) and math.abs(lo - btm_y) / lo * 100 <= swTol
    if sigOk and (not useWt or wtMin <= wtOS + wtTol)
        box.new(x1, hi, n, lo, border_color = color.new(color.green, 20), bgcolor = bullCol, border_width = 2)
        label.new(sigLoBar, lo, "5", style = label.style_label_up, color = color.new(color.green, 100), textcolor = color.green, size = size.small)
        chochLine(chXUp, chLvlUp, color.green, true)
        lBot := lo, lBotBar := sigLoBar, lArmed := true
        sArmed := false
        sigLoUsed := true

// ── обновление экстремума до окончания A — формация отменяется (аналитик пересобирает от нового экстремума)
if sArmed and high > sTop
    sArmed := false
if lArmed and low < lBot
    lArmed := false

// ── волна A закончена: встречный CHoCH
if showA and sArmed and bullChoch and not bearChoch
    len = math.min(n - sTopBar, maxLook)
    a = low, int aOff = 0
    for k = 0 to len
        if low[k] < a
            a := low[k]
            aOff := k
    A = sTop - a
    if A > 0
        z05 = a + 0.5 * A, z705 = a + 0.705 * A
        sStopPx := a + 0.886 * A
        sZone := box.new(n - aOff, z705, n, z05, border_color = color.new(color.orange, 40), bgcolor = zoneCol)
        sStop := line.new(n - aOff, sStopPx, n, sStopPx, color = color.red, style = line.style_dashed)
        label.new(n - aOff, a, "A", style = label.style_label_up, color = color.new(color.blue, 100), textcolor = color.blue, size = size.small)
    sArmed := false
if showA and lArmed and bearChoch and not bullChoch
    len = math.min(n - lBotBar, maxLook)
    a = high, int aOff = 0
    for k = 0 to len
        if high[k] > a
            a := high[k]
            aOff := k
    A = a - lBot
    if A > 0
        z05 = a - 0.5 * A, z705 = a - 0.705 * A
        lStopPx := a - 0.886 * A
        lZone := box.new(n - aOff, z05, n, z705, border_color = color.new(color.orange, 40), bgcolor = zoneCol)
        lStop := line.new(n - aOff, lStopPx, n, lStopPx, color = color.green, style = line.style_dashed)
        label.new(n - aOff, a, "A", style = label.style_label_down, color = color.new(color.blue, 100), textcolor = color.blue, size = size.small)
    lArmed := false

if showAllCh and bearChoch
    chochLine(chXDn, chLvlDn, color.new(color.red, 40), false)
if showAllCh and bullChoch
    chochLine(chXUp, chLvlUp, color.new(color.green, 40), true)

if bullBreak
    lastBullBreak := n
if bearBreak
    lastBearBreak := n

alertcondition(bearChoch, "CHoCH вниз (медвежья формация)", "OKO-SM: внутренний CHoCH вниз")
alertcondition(bullChoch, "CHoCH вверх (бычья формация)",   "OKO-SM: внутренний CHoCH вверх")
