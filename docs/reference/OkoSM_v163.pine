color2 = input.color(color.new(color.orange, 0), "", group = "SMA Settings", inline = "01")

showLen3 = input.bool(true, "", group = "SMA Settings", inline = "01")
len3 = input(89, title="Sma3", inline = "01", group = "SMA Settings")
out3 = ta.sma(src, len3)
color3 = input.color(color.new(color.maroon, 0), "", group = "SMA Settings", inline = "01")

showLen4 = input.bool(true, "", group = "SMA Settings", inline = "02")
len4 = input(144, title="Sma4", inline = "02", group = "SMA Settings")
out4 = ta.sma(src, len4)
color4 = input.color(color.new(color.green, 0), "", group = "SMA Settings", inline = "02")

showLen5 = input.bool(true, "", group = "SMA Settings", inline = "02")
len5 = input(233, title="Sma5", inline = "02", group = "SMA Settings")
out5 = ta.sma(src, len5)
color5 = input.color(color.new(color.purple, 0), "", group = "SMA Settings", inline = "02")


plot(showLen and showCmaLines ? out : na, color = color, title="Sma1")
plot(showLen2 and showCmaLines ? out2 : na, color = color2, title="Sma2")
plot(showLen3 and showCmaLines ? out3 : na, color = color3, title="Sma3")
plot(showLen4 and showCmaLines ? out4 : na, color = color4, linewidth=1, title="Sma4")
plot(showLen5 and showCmaLines ? out5 : na, color = color5, linewidth=3, title="Sma5")


