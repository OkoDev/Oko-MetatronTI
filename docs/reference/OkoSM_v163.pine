//@version=5

indicator("OKO - SM", overlay = true 
  , max_labels_count = 500
  , max_lines_count = 500
  , max_boxes_count = 500
  , max_bars_back = 500)


showAlerts = input.bool(true, "Alerts", group = "Show settings",inline = "01")
scalpingAlerts = input.bool(true, "Scalping", group = "Show settings", inline = "01")
showPivots = input.bool(true, "Pivots", group = "Show settings",inline = "01")

showOrderBlocks = input.bool(true, "Order Blocks", group = "Show settings",inline = "02")
showChannel = input.bool(true, "Channel", group = "Show settings",inline = "02")
show3orMore = input.bool(true, "3 or More", group = "Show settings",inline = "02")

// showBBinput = input.bool(true, "BB", group = "Show settings",inline = "02")

i_zigZag     = input.bool(true, "Waves", group = "Show settings", inline = "03")
showCmaLines = input.bool(true, "CMA", group = "Show settings",inline = "03")
showBarColor = input.bool(true, "Bar Colors", group = "Show settings",inline = "03")
showTrendLine = input.bool(true, "Trend line", group = "Show settings",inline = "03")

/////////////////////////////////
//WICK.ed
// Define "n" as the number of periods and keep a minimum value of 2 for error handling.
n1 = input.int(title="Periods", defval=2, minval=2) 
fractalBars = input.int(title="3 or 5 Bar Fractal", defval=3, options=[3, 5])

// Logic 
dnFractal = if fractalBars == 5 
    (high[n1-2] < high[n1]) and (high[n1-1] < high[n1]) and (high[n1+1] < high[n1]) and (high[n1+2] < high[n1])
else
    (high[n1-1] < high[n1]) and (high[n1+1] < high[n1]) 

upFractal = if fractalBars == 5 
    (low[n1-2] > low[n1]) and (low[n1-1] > low[n1]) and (low[n1+1] > low[n1]) and (low[n1+2] > low[n1])
else
    (low[n1-1] > low[n1]) and (low[n1+1] > low[n1]) 

// Plot the fractals as shapes on the chart.
// Down Arrow above candles 
plotshape(dnFractal, style=shape.triangledown, location=location.abovebar, offset=-2, color=color.new(color.white, 25))    
// Up Arrow below candles 
plotshape(upFractal, style=shape.triangleup, location=location.belowbar, offset=-2, color=color.new(color.white, 25))// END. 



// 3 OR MORE
///////////////////////////////////////////

bull_candle = close - open > 0
bear_candle = close - open < 0


tc = close[2] - open[2] > 0 //thirdcandle
sc = close[1] - open[1] > 0 //second candle
fc = close - open > 0 //first candle
threesame = tc == sc and sc == fc and tc == fc

three_bull = bull_candle and threesame
three_bear = bear_candle and threesame

barcolor(show3orMore and three_bear? #dc3030: show3orMore and three_bull? #56a656 : na,-2)
barcolor(show3orMore and three_bear? #dc3030: show3orMore and three_bull? #56a656: na,-1)
barcolor(show3orMore and three_bear? #dc3030: show3orMore and three_bull? #56a656 : na) 

// 3 OR MORE
///////////////////////////////////////////


float factor = input.float(1,title="Activity", step=0.1, inline = "Alerts", group = "Alerts Setings"  )
int pd = input.int(43,title="Volatility", minval = 1, maxval = 100,inline = "Alerts", group = "Alerts Setings")
float up = hl2 - (factor * ta.atr(pd))
dn = hl2 + (factor * ta.atr(pd))

float trendup = 0.0
float trenddown = 0.0
float trendX = 0.0

trendup := hl2[1] > trendup[1] ? math.max(up, trendup[1]) : up
trenddown := hl2[1] < trenddown[1] ? math.min(dn, trenddown[1]) : dn
trendX := hl2 > trenddown[1] ? 1 : hl2 < trendup[1] ? -1 : nz(trendX[1], 1)
tsl = trendX == 1 ? trendup : trenddown
color linecolor = trendX == 1 ? color.green : color.red


