INP_supportsB   = input.int( 3, "S/R Pivots", inline = "line2", group = "Pivot Settings", minval = 0, maxval = i_maxLevels)
INP_flavourB    = i_piv0
INP_resistsB    = INP_supportsB

// -- Pivots C Main Settings

INP_resolutionC = input.string( i_res9, " ",
      inline = "line3",
      group = "Pivot Settings",
      options = [ i_res0, i_res1, i_res2, i_res3, i_res4, i_res5, i_res6, i_res7, i_res8, i_res9, i_res10, i_res11, i_res12
      ])
INP_showPivotsC = input( false, "", inline = "line3", group = "Pivot Settings")
INP_supportsC   = input.int( 3, "S/R Pivots", inline = "line3", group = "Pivot Settings", minval = 0, maxval = i_maxLevels )
INP_flavourC    = i_piv0
