//Ploting SMA Lines    
src = input(close, title="Source", group = "SMA Settings")

showLen = input.bool(true, "", group = "SMA Settings", inline = "00")
len = input.int(21, title="Sma1", group = "SMA Settings", inline = "00")
out = ta.sma(src, len)
color = input.color(color.new(color.blue, 0), "", group = "SMA Settings", inline = "00")

showLen2 = input.bool(true, "", group = "SMA Settings", inline = "01")
len2 = input(55, title="Sma2", inline = "01", group = "SMA Settings")
